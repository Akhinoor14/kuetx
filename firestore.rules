rules_version = '2';

// Deploy with:  firebase deploy --only firestore:rules
// Test first with the Firebase Emulator Suite.
//
// This file encodes the KUETx Manifesto v1.0 (July 2026) hierarchy:
//   Founder (admins/{uid}) -> Head of Ops + 9 Core Team leads -> Senior
//   Campus Lead (per dept) -> Campus Lead (per dept+batch) -> CR (a
//   per-class student feature, NOT an official post).
//
// Deliberate design notes carried over from earlier decisions:
// - Founder auth is a *separate* secondary Firebase app instance
//   client-side (adminAuth.js) but the SAME Firestore project/rules.
// - Removal authority is NOT symmetric with appointment authority
//   (Manifesto Code of Conduct §6): Head of Ops removes Campus Leads;
//   Founder removes Senior Campus Leads and Core Team leads. This is
//   intentional accountability separation, not an oversight.
// - Per the Data & Privacy Policy, only Founder has broad Firestore
//   access; "Data & Systems Lead / Backend Engineer" access described in
//   the manifesto is infrastructure/console-level, not additional
//   client-app Firestore rule grants — so those two roles get NO extra
//   read rules here beyond what every signed-in user already has.

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------
    // Helpers — identity & role checks
    // -------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }
    // Real account = signed in AND not an anonymous session. Firebase
    // Anonymous Auth still satisfies isSignedIn() (request.auth != null
    // is true for anonymous users too), so anything meant to be limited
    // to actual KUET students with a real Google/email account — most
    // importantly, showing up in a class's shared Classmates/CR data —
    // must check this, not just isSignedIn(). This is enforced here (not
    // only client-side in App.jsx's auto-join guard) because a client
    // guard can be bypassed by a modified/malicious client; the rule is
    // the actual security boundary. Anonymous accounts keep full access
    // to every personal-only feature (users/{uid}/data, Notes, Diary,
    // Wallet, etc.) — this restriction is scoped narrowly to group
    // membership only, same principle as the roll-ownership fallback
    // documented in App.jsx.
    function isRealAccount() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function hasGlobalRole(role) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/staff/$(request.auth.uid)/roles/$(role));
    }
    function isHeadOfOps()   { return hasGlobalRole('head_of_ops'); }
    // Currently unused by any rule below — kept for the follow-up work of
    // wiring Content Lead moderation into the existing Question Bank
    // system (see groupSync.js's note on why there's no `resources` here).
    function isContentLead() { return hasGlobalRole('content_lead'); }
    function isHeadOfGrowth(){ return hasGlobalRole('head_of_growth'); }

    function isSCLFor(dept) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/staff/$(request.auth.uid)/roles/$('senior_campus_lead_' + dept));
    }
    function isCLFor(groupId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/staff/$(request.auth.uid)/roles/$('campus_lead_' + groupId));
    }
    // A group id is `${BATCH}_${DEPT}` for single-section depts, or
    // `${BATCH}_${DEPT}_${SECTION}` for the 4 multi-section depts (see
    // groupUtils.js: MULTI_SECTION_DEPTS/getGroupId) — so the department
    // for "is this person the SCL of this group's department" checks can
    // always be extracted from index 1, regardless of a trailing section
    // segment.
    function deptOfGroup(groupId) {
      return groupId.split('_')[1];
    }
    // Mirrors groupUtils.js's MULTI_SECTION_DEPTS. Must be kept in sync
    // by hand — rules can't import JS, so this hardcodes the same 4 dept
    // codes (the 120-seat depts: CE, EEE, ME, CSE) that groupUtils.js
    // derives from DEPARTMENTS' seats field.
    function isMultiSectionDept(dept) {
      return dept in ['CE', 'EEE', 'ME', 'CSE'];
    }
    // Reconstructs the expected groupId from a write payload's own
    // batch/dept/section fields, mirroring groupUtils.js's getGroupId.
    // Used anywhere a rule needs to confirm groupId actually agrees with
    // the batch/dept (/section) the request also claims — without this,
    // any equality check written as `groupId == batch + '_' + dept` would
    // incorrectly reject every write from a multi-section dept, since
    // those groupIds carry a 3rd `_SECTION` segment.
    function expectedGroupId(data) {
      return isMultiSectionDept(data.dept)
        ? data.batch + '_' + data.dept + '_' + data.section
        : data.batch + '_' + data.dept;
    }
    function isSCLForGroup(groupId) {
      return isSCLFor(deptOfGroup(groupId));
    }

    function isGroupMember(groupId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }
    function memberDoc(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data;
    }
    // Membership check for an arbitrary OTHER uid, not the requester
    // themself — needed anywhere a CL/SCL/Admin is about to act on a
    // specific target (e.g. flagging an email) and the rule must confirm
    // that target is actually within the acting person's own scope, not
    // just that the acting person HOLDS a CL/SCL role somewhere.
    function targetIsGroupMember(uid, groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId)/members/$(uid));
    }
    function isVerifiedMember(groupId) {
      return isGroupMember(groupId) && memberDoc(groupId).verified == true;
    }
    function isGroupCR(groupId)  { return isGroupMember(groupId) && memberDoc(groupId).role == 'cr'; }
    function isGroupACR(groupId) { return isGroupMember(groupId) && memberDoc(groupId).role == 'acr'; }

    function crCount(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId)/meta/crStatus)
        ? get(/databases/$(database)/documents/groups/$(groupId)/meta/crStatus).data.count
        : 0;
    }
    // Only CR/ACR/CL/Admin can edit once a CR exists; if the group
    // currently has no CR, any *verified* member may (see conversation
    // history for why this fallback window is intentionally narrow).
    function isContentEditor(groupId) {
      return isAdmin() || isCLFor(groupId) || isGroupCR(groupId) || isGroupACR(groupId) ||
        (crCount(groupId) <= 0 && isVerifiedMember(groupId));
    }

    // ── Faculty Module — MANUAL VERIFICATION POLICY ───────────────────────
    // Auto-approval is OFF. faculty/{uid} existing just means an account
    // was created (email/password + domain-format check passed) — it does
    // NOT grant access to real teaching features. isFaculty() below is
    // ONLY for account-existence checks: onboarding/profile-completion
    // screens, and read access to public-ish directory info (a student
    // reading a teacher's name/title, a routine grid showing who teaches
    // what). It must never gate an actual write or a feature that matters.
    //
    // isVerifiedFaculty() is the real gate — verifiedAt != null, set ONLY
    // by a Founder/Admin clicking Verify in the Admin panel's Faculty →
    // Pending tab (see AdminDashboard.jsx), never by the client itself.
    // Every faculty write/feature that isn't pure onboarding uses this.
    function isFaculty(uid) {
      return exists(/databases/$(database)/documents/faculty/$(uid));
    }

    function isVerifiedFaculty(uid) {
      return exists(/databases/$(database)/documents/faculty/$(uid))
        && get(/databases/$(database)/documents/faculty/$(uid)).data.verifiedAt != null;
    }

    function isFacultyFor(groupId, assignmentId) {
      return isVerifiedFaculty(request.auth.uid)
        && request.auth.uid in
           get(/databases/$(database)/documents/groups/$(groupId)/facultyAssignments/$(assignmentId)).data.teacherUids;
    }

    // Tier-1 institutional verification lives in a separate collection
    // (verifiedRolls/{roll}), written only by the dedicated verification
    // flow (kuetEmailVerify.js's secondary Firebase app session) — the
    // visitor's own main session's auth token is never touched or
    // inspected here, by design (see that file's header comment for why).
    function rollIsInstitutionallyVerified(roll) {
      return exists(/databases/$(database)/documents/verifiedRolls/$(roll));
    }

    // Roll middle 2 digits -> dept code (must mirror ROLL_DEPT_MAP in
    // ProfileSetupModal.jsx exactly — the roll digits are a numeric dept
    // *code*, not the dept name itself, so they can't be compared to
    // groupId's dept segment directly).
    function deptCodeFromRoll(roll) {
      return {
        '25': 'ARCH', '23': 'BECM', '15': 'BME', '01': 'CE', '29': 'CHE',
        '07': 'CSE', '09': 'ECE', '03': 'EEE', '13': 'ESE', '11': 'IPE',
        '19': 'LE', '05': 'ME', '27': 'MSE', '31': 'MTE', '21': 'TE', '17': 'URP',
      }[roll[2:4]];
    }

    // Tier-1 auto-verify also needs the claimed roll to actually
    // correspond to THIS group's batch+dept, not just to *any* verified
    // roll — otherwise a verified roll for one class could auto-verify
    // someone into a different class.
    //
    // Batch segment MUST be an EXACT match against the app's own
    // canonical batch format (groupUtils.js/extractBatchFromRoll:
    // "2K" + the roll's first two digits, e.g. roll 2107123 -> "2K21"),
    // not a substring check. A substring check (groupId batch containing
    // roll[0:2] ANYWHERE) would let a roll from batch 21 auto-verify
    // into a maliciously-named group like "1221_CSE" or "9921_CSE" —
    // group ids are freely creatable by any signed-in user (see
    // `groups/{groupId}` create rule below, which has no shape
    // validation), so this can't rely on groupId always being
    // well-formed; the exactness has to be enforced right here.
    function rollMatchesGroup(roll, groupId) {
      return groupId.split('_')[1] == deptCodeFromRoll(roll)
        && groupId.split('_')[0] == ('2K' + roll[0:2]);
    }

    // -------------------------------------------------------------
    // Pre-existing personal data (unchanged)
    // -------------------------------------------------------------
    match /users/{uid}/data/{key} {
      // NOTE (Phase 5 migration): the 'profile' key is being moved OUT of
      // this generic per-key bucket into the dedicated
      // students/{dept}/{batch}/{uid} collection below — see that match
      // block's comment for why. This rule is intentionally left open to
      // ANY key here (including a stray/legacy 'profile' doc some already-
      // synced accounts may still have sitting here from before this
      // migration) because firebaseSync.js's generic push/pull loop still
      // owns every other personal key (Notes, Diary, Wallet, Settings,
      // Schedule, Assignments, etc. — ~30 keys/user) and nothing about
      // that generic mechanism changes in this phase. Do not narrow this
      // rule to exclude 'profile' — that would break pullAllFromFirestore
      // for any account with a leftover legacy profile doc still present.
      allow read: if isSignedIn() && (request.auth.uid == uid
        // Staff & Roles "Current Holders" name-resolution fallback
        // (getStaffDisplayInfo in staffSync.js) — only reached for a
        // staff-role holder who isn't a member of any class group, so
        // there's no groups/*/members doc to read a name from. Scoped to
        // just the `profile` key, read-only, Admin/Head of Ops only.
        // Kept even though staffSync.js's primary path now reads from
        // students/{dept}/{batch}/{uid} — this remains as the fallback
        // for legacy/leftover docs (see note above).
        || (key == 'profile' && (isAdmin() || isHeadOfOps())));
      allow write: if isSignedIn() && request.auth.uid == uid;
    }
    match /users/{uid}/meta/{docId} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // -------------------------------------------------------------
    // Student profile — Phase 5 migration target. Moved OUT of the
    // generic users/{uid}/data/{key} key-value bucket (above) into its
    // own nested-by-value path, dept/batch taken from the profile's own
    // claimed roll so the doc's location itself encodes department and
    // batch (needed for cheap collectionGroup('students') dept/batch-
    // scoped queries without a full scan+filter).
    //
    // {dept} and {batch} in the PATH must match the roll embedded in the
    // profile's own studentId field — otherwise a client could write its
    // profile doc under a dept/batch that doesn't correspond to its own
    // roll (e.g. to appear in a different dept's roster), which the old
    // flat users/{uid}/data/profile shape had no way to prevent since
    // there was no dept/batch in the *path* at all. deptCodeFromRoll(...)
    // reuses the exact same 2-digit->dept-code map that rollMatchesGroup
    // already relies on above (kept as one source of truth), and batch
    // must equal the canonical "2K"+roll[0:2] format used everywhere else
    // in this file (extractBatchFromRoll in the client, rollMatchesGroup
    // above).
    //
    // studentId itself is immutable once set (matches "Role Should Be
    // Permanent"-style reasoning used for users/{uid}.role above) — a
    // student cannot silently swap rolls after the fact by editing their
    // own profile doc, since that would also require re-locating the doc
    // to a new dept/batch path, which is exactly what rollOwnership.js's
    // claim/unlock flow is supposed to gate, not a plain profile edit.
    match /students/{dept}/{batch}/{uid} {
      allow read: if isSignedIn() && (
        request.auth.uid == uid
        || isAdmin() || isHeadOfOps()
        // Same "resolve a name for a staff-role holder" fallback as the
        // legacy path above, now against the real target location.
      );
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.studentId is string
        && dept == deptCodeFromRoll(request.resource.data.studentId)
        && batch == ('2K' + request.resource.data.studentId[0:2]);
      allow update: if isSignedIn() && request.auth.uid == uid
        // studentId (and therefore dept/batch, since they're derived from
        // it) is immutable after create — path already pins dept/batch,
        // this additionally pins the studentId field inside the doc so a
        // client can't rewrite studentId to a DIFFERENT roll that still
        // happens to hash to the same dept/batch path segments.
        && request.resource.data.studentId == resource.data.studentId;
      allow delete: if false;
    }

    // -------------------------------------------------------------
    // Root user doc — Phase E (push notifications). Only field ever
    // written here client-side is fcmTokens (see src/lib/push.js
    // saveTokenForCurrentUser/disablePush). Kept deliberately narrow
    // (hasOnly(['fcmTokens'])) so this new rule can't be used to write
    // any other field onto users/{uid} — all other personal data still
    // lives under users/{uid}/data/{key} and users/{uid}/meta/{docId}
    // above, untouched by this.
    // -------------------------------------------------------------
    // -------------------------------------------------------------
    // Root user doc — Phase E (push notifications) + role persistence.
    // Client-writable fields here are exactly: fcmTokens (push.js) and
    // role (accountRole.js / RoleSelectScreen.jsx — the explicit,
    // server-side, cross-device record of 'student' | 'teacher', set once
    // at Role Select and never changed again by the client after that).
    // `role` may only ever be set on CREATE or on an UPDATE where it
    // didn't exist before (resource.data.role == null) — once set, it's
    // immutable from the client, matching "Role Should Be Permanent."
    // -------------------------------------------------------------
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['fcmTokens', 'role'])
        && (!('role' in request.resource.data)
            || request.resource.data.role in ['student', 'teacher']);
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmTokens', 'role'])
        && (
          !('role' in request.resource.data.diff(resource.data).affectedKeys())
          || (
            // role can only be WRITTEN if it wasn't already set —
            // permanent once chosen, per "Role Should Be Permanent".
            !('role' in resource.data)
            && request.resource.data.role in ['student', 'teacher']
          )
        );
      allow delete: if false;
    }

    // -------------------------------------------------------------
    // Username -> uid lookup for the username+password student auth flow
    // (studentUsernameAuth.js). This collection previously had NO rule at
    // all here — every read/write was silently denied by Firestore's
    // default-deny, meaning username signup/login never actually worked
    // client-side, regardless of the code's own logic being correct
    // (see studentUsernameAuth.js's own "TODO(Phase 5)" comment, which
    // flagged this exact gap in advance).
    //
    // Read must stay OPEN to signed-OUT visitors: resolveUsernameToUid()
    // (login) and checkUsernameAvailable() (signup) both need to read
    // this doc BEFORE the visitor has a Firebase Auth session — that's
    // the entire point of a username-based login (you don't have a
    // session yet, that's what you're trying to get). There's nothing
    // sensitive in the doc itself (just a uid + createdAt), so an open
    // read is the same privacy shape as "is this username taken" on any
    // ordinary signup form.
    //
    // Create/update: only the claiming uid may write their OWN uid into
    // the doc, and only while doing so doesn't steal someone else's
    // already-claimed name — mirrors claimUsernameForUid()'s own
    // transaction check (resource.data.uid must be absent or already
    // equal to the caller) so the client-side transaction is actually
    // backed by a server-side guarantee, not just client good faith.
    // Delete: only the claiming uid, for releaseUsernameClaim()'s
    // best-effort cleanup after a failed signup.
    match /usernames/{username} {
      allow read: if true;
      allow create, update: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && (resource == null || resource.data.uid == request.auth.uid);
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // -------------------------------------------------------------
    // Institutional verification facts — see kuetEmailVerify.js. Written
    // only by the separate verification-app session whose OWN auth token
    // genuinely carries a verified @stud.kuet.ac.bd email; the visitor's
    // main session is never involved in this write.
    // -------------------------------------------------------------
    // -------------------------------------------------------------
    // OTP email verification (functions/index.js requestOtp/verifyOtp) —
    // shared by student + faculty "code main, link backup" flow. Every
    // read/write here happens ONLY via the Admin SDK inside those two
    // Cloud Functions; the client calls them through httpsCallable, never
    // touches these documents directly. Denying all client access is the
    // actual security boundary — a client that could read otpCodes/{email}
    // could read someone else's code, and a client that could write it
    // could self-verify without ever proving mailbox ownership.
    // -------------------------------------------------------------
    match /otpCodes/{email} {
      allow read, write: if false;
    }
    match /mail/{docId} {
      allow read, write: if false;
    }

    match /verifiedRolls/{roll} {
      allow read: if isSignedIn();
      // MUST be an exact match of the roll to the token's verified KUET
      // email's local-part suffix — NOT a substring/contains check.
      // A substring check here (e.g. '.*' + roll + '.*@stud...') would
      // let one real mailbox like rakib2113014@stud.kuet.ac.bd satisfy
      // this rule for /verifiedRolls/113014, /verifiedRolls/211301, or
      // any other digit-substring of the real roll — none of which the
      // official kuetEmailVerify.js client ever intentionally writes,
      // but nothing stops a modified client, a stray script, or a future
      // bug from writing to those doc paths directly, since Firestore
      // rules — not client code — are the actual security boundary here.
      // Requiring the LOCAL PART TO EQUAL exactly (lowercased letters)+
      // roll, with roll itself constrained to exactly 7 digits, closes
      // that: only the one true roll encoded in the verified email can
      // ever be written, which is the guarantee rollMatchesGroup and
      // every auto-join rule downstream actually depend on.
      // Two ways to create this doc:
      //  1. The original OTP/magic-link path's own condition — token
      //     belongs to a session that itself just proved ownership of
      //     exactly this roll's KUET email. (Kept for the still-live
      //     Cloud Functions requestOtp/verifyOtp path, even though no
      //     client currently calls them — Admin SDK writes bypass rules
      //     entirely anyway, so this branch only ever matters if a
      //     client-side caller is reintroduced later.)
      //  2. Founder/Admin manual approval (manualVerifyRequests.js's
      //     approveManualVerifyRequest()) — the Founder's own signed-in
      //     session writes this directly on behalf of a student whose
      //     request they reviewed by hand. Their token was never a KUET
      //     student email, so condition 1 alone would always reject this
      //     write — this is the actual fix that makes the kept
      //     Founder-WhatsApp fallback path work at all.
      allow create: if (request.auth.token.email_verified == true &&
        roll.matches('^[0-9]{7}$') &&
        request.auth.token.email.lower().matches('^[a-z]+' + roll + '@stud[.]kuet[.]ac[.]bd$'))
        || isAdmin() || isHeadOfOps();
      allow update, delete: if false; // create-once, permanent
    }

    // -------------------------------------------------------------
    // Faculty Module (§10 of the merged Faculty Module prompt).
    // faculty/{uid}: the account's own profile doc. Read is open to any
    // signed-in user (student pages may need to display a teacher's name/
    // title; officialEmail isn't secret, it's an institutional address).
    // Create must start unverified (verifiedAt: null) — mirrors
    // facultySync.js's createFacultyAccountDoc(), which always writes it
    // that way. Faculty accounts are auto-active the moment this doc
    // exists (see isFaculty() above) — verifiedAt is now purely the
    // "Blue Tick" flag, and it can ONLY ever be set by the Founder/Admin
    // approving the account (AdminDashboard's Approvals tab), never by
    // the faculty account itself. This closes the same self-grant risk
    // the old exists(verifiedFacultyEmails/...) check closed, just
    // against a different writer (Admin approval action, not a magic-link
    // bridge).
    // -------------------------------------------------------------
    match /faculty/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.verifiedAt == null;
      allow update: if (isSignedIn() && request.auth.uid == uid
          && request.resource.data.verifiedAt == resource.data.verifiedAt)
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verifiedAt', 'verifiedBy']));
      allow delete: if isAdmin();

      // BUGFIX: this subcollection previously had NO rules block at all.
      // Firestore does not inherit a parent document's rules into its
      // subcollections — each path needs its own explicit match. Without
      // this, every read/write against faculty/{uid}/classIndex fell
      // through to Firestore's default-deny, which silently broke both
      // "My Classes" (FacultyClasses.jsx) and "My Schedule"
      // (FacultySchedule.jsx): createFacultyAssignment()'s own setDoc into
      // this collection failed, and subscribeMyClassIndex()'s onSnapshot
      // error handler swallows the resulting permission-denied error and
      // just calls back with an empty array — so both pages always looked
      // empty with no visible error, exactly matching the reported "mone
      // hocche kicchu nai" (looks like nothing's there) symptom.
      //
      // read: the owning faculty account only (this is their own private
      // fan-out index, not something CR/students should be reading).
      // write: only the owning faculty account, and only for their own
      // uid — createFacultyAssignment/joinFacultyAssignment both write via
      // the signed-in user's own session, never on someone else's behalf.
      match /classIndex/{assignmentId} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow write: if isSignedIn() && request.auth.uid == uid;
      }

      // Meetings — a faculty account's own list of scheduled meetings
      // (class-related or otherwise: department meetings, viva boards,
      // student consultations). Same owner-only shape as classIndex above
      // — this is private to the faculty account, never read by students
      // or other faculty. Write additionally requires the Blue Tick
      // (isVerifiedFaculty) — scheduling a real meeting is a "fake
      // teacher could cause damage" action per the manual verification
      // policy (§ "Faculty Module"), same tier as facultyAssignments
      // create/marks/notices above, so an unverified account can still
      // read (e.g. see an empty list on their own dashboard) but not
      // schedule one.
      match /meetings/{meetingId} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow write: if isSignedIn() && request.auth.uid == uid && isVerifiedFaculty(uid);
      }
    }

    // -------------------------------------------------------------
    // Services / Provider marketplace — Phase 1 (see
    // SERVICES_PROVIDER_PLAN.md §2, §4, §10). providers/{uid}: the
    // account's own profile+status doc, same top-level pattern as
    // faculty/{uid} above.
    //
    // Unlike faculty/{uid} (verifiedAt is a soft browse-but-don't-write
    // gate), status here is a HARD GATE at the app level (RequireProvider
    // in App.jsx) — but the RULES enforcement is the same shape: status
    // can only ever be set to 'pending' by the provider themselves (at
    // create, and again at re-submit after a rejection), and can ONLY be
    // moved to 'verified'/'rejected'/'deactivated' by the Founder
    // (isAdmin()). A provider can never self-verify, exactly like a
    // faculty account can never self-grant its own Blue Tick.
    //
    // read: split in two. Everything EXCEPT phone is open to any
    // signed-in user (displayName/status/serviceType etc. — the
    // student-facing Services list and dashboard headers need these, and
    // none of it is sensitive). `phone` is gated separately: §10 of the
    // plan is explicit that the OWNER's phone number should only be
    // readable by a student once they have a confirmed (or later-stage)
    // booking with that provider — not by every signed-in student
    // unconditionally, and not before confirmation. (An earlier version
    // of this comment argued the owner's own submitted contact info was
    // exempt from §10 since that section's "student's phone" clause is
    // literally about booking documents — that reading doesn't survive a
    // second look: §10 has its own separate sentence specifically about
    // the OWNER's number, gated to confirmed bookings. Firestore field-
    // level security doesn't exist, so the field itself can't be
    // selectively hidden within a single doc read — the phone had to
    // move to its own sub-document instead, gated by its own rule below.)
    match /providers/{uid} {
      allow read: if isSignedIn();

      // Create: only the owning account, and only ever as 'pending' with
      // verifiedAt null — mirrors faculty/{uid}'s create rule exactly.
      // `phone` is intentionally NOT part of the main providers/{uid} doc
      // (see providers/{uid}/contact/phone below) — this create only
      // allows the public fields.
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.verifiedAt == null
        && !('phone' in request.resource.data);

      // Update: two disjoint cases.
      //  1. The owning account re-submitting after a rejection (Gap 6) —
      //     may only move status FROM 'rejected' back TO 'pending', and
      //     may only touch the fields the re-submit form actually edits
      //     on this doc (status, rejectedReason, displayName, serviceType,
      //     requestedAt) — phone re-submission goes through the
      //     contact/phone sub-document's own rule instead. It can never
      //     touch verifiedAt, verifiedBy, or serviceIds itself — those
      //     stay exactly as before.
      //  2. Founder review action (verify / reject / deactivate) — may
      //     only touch {status, verifiedAt, verifiedBy, rejectedReason},
      //     and status must land on one of the three valid outcomes.
      allow update: if (isSignedIn() && request.auth.uid == uid
          && resource.data.status == 'rejected'
          && request.resource.data.status == 'pending'
          && request.resource.data.verifiedAt == null
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'rejectedReason', 'displayName', 'serviceType', 'requestedAt']))
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'verifiedAt', 'verifiedBy', 'rejectedReason'])
          && request.resource.data.status in ['verified', 'rejected', 'deactivated']);

      allow delete: if isAdmin();

      // -----------------------------------------------------------
      // providers/{uid}/contact/phone — the owner's phone number,
      // split out of the parent doc specifically so it can have its own
      // read rule (§10). A single Firestore document can't selectively
      // hide one field from some readers and not others, so the ONLY way
      // to gate just the phone (while leaving displayName/status/etc.
      // openly readable above) is to give it its own sub-document.
      //
      // Readable by: the owning provider themselves (so their own
      // dashboard can show what they submitted), the Founder (isAdmin —
      // needed for manual verification contact, §4), or a student who
      // has at least one booking with status 'confirmed' or 'done' on
      // ANY of this provider's services (§10: "once confirmed"; 'done'
      // is included since a completed booking's student legitimately
      // still has standing to have had the number, e.g. for a follow-up).
      // Checking this requires knowing which serviceIds belong to this
      // provider, which is why the check reads providers/{uid} itself
      // (serviceIds) then queries nothing further — a get() per
      // serviceId list entry isn't needed because hasConfirmedBookingWithProvider
      // below only needs to prove ONE match exists, not enumerate.
      //
      // NOTE: a full "does this student have a confirmed booking with
      // ANY service under this provider" check would ideally use a
      // collectionGroup query inside the rule, but Firestore rules can't
      // run arbitrary queries — only exists()/get() on a known path. So
      // this is scoped to a single serviceId, passed as a query param
      // equivalent: the client reads providers/{uid}/contact/phone only
      // from ServiceDetail.jsx, which already knows serviceId from the
      // route, and the rule below checks that ONE specific service's
      // bookings for a confirmed/done match — not every service the
      // provider might own. (In Phase 2's data model each provider has
      // exactly one service in practice, per providerSync.js's Phase 1
      // comment, so this isn't a real limitation yet; flagging it for
      // whoever adds true multi-service providers later.)
      // -----------------------------------------------------------
      match /contact/phone {
        allow read: if isSignedIn() && (
          request.auth.uid == uid
          || isAdmin()
          || hasConfirmedBookingWithProvider(uid)
        );
        // Write: the owning provider only — same standing that used to
        // write `phone` on the parent doc (at create, or re-submit after
        // rejection). Founder never writes this, only reads it.
        allow write: if isSignedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['value']);
      }
    }

    // Helper for providers/{uid}/contact/phone's read rule (§10): true if
    // the signed-in student has at least one confirmed-or-done booking on
    // this provider's service.
    //
    // Scoped to serviceIds[0] — Phase 2's data model gives every provider
    // exactly one service in practice (providerSync.js's own Phase 1
    // comment confirms this), so this covers the real case. A true
    // multi-service provider would need this to loop over serviceIds,
    // which rules language can't do with a dynamic list; flagging for
    // whoever adds real multi-service providers later (likely fix:
    // denormalize a per-student "has confirmed booking with this
    // provider" flag onto a small owner-writable doc at confirm time,
    // rather than trying to query bookings live from inside a rule).
    //
    // The actual existence check queries this student's OWN bookings via
    // the same collection-group-free path shape used elsewhere in this
    // file: myActiveBookingId, a small per-student pointer doc written by
    // confirmBooking()/finishBooking() at the same time status changes,
    // living at services/{serviceId}/confirmedStudents/{uid} — see that
    // match block below. This keeps the phone-gate rule a cheap single
    // exists() check instead of an unsupported live query.
    function hasConfirmedBookingWithProvider(providerUid) {
      let provider = get(/databases/$(database)/documents/providers/$(providerUid)).data;
      return provider.serviceIds.size() > 0
        && exists(/databases/$(database)/documents/services/$(provider.serviceIds[0])/confirmedStudents/$(request.auth.uid));
    }


    // -------------------------------------------------------------
    // Services / Provider marketplace — Phase 2 (see
    // SERVICES_PROVIDER_PLAN.md §2, §5-§7, §10). services/{serviceId}:
    // the operational, frequently-updated sibling of providers/{uid}
    // (Phase 1's identity+verification doc).
    // -------------------------------------------------------------

    function isVerifiedProviderUid(uid) {
      return exists(/databases/$(database)/documents/providers/$(uid))
        && get(/databases/$(database)/documents/providers/$(uid)).data.status == 'verified';
    }

    function ownsService(serviceId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/services/$(serviceId)).data.providerUid == request.auth.uid;
    }

    // Gap 5 (server-side): true if the offering being booked is both
    // present on the service and currently isAvailable. Previously this
    // was client-side only (createBooking() in serviceSync.js) — a
    // modified client could still hit `create` below and slip a booking
    // onto a closed offering, since the rule had no way to see the
    // parent service's offerings array. get() on the sibling service doc
    // closes that: the booking create rule now re-derives the same
    // check the client already does, so a forged client can no longer
    // bypass it.
    // Firestore Rules language has no arrow-function lambdas (this is
    // NOT plain JS) — there is no `.filter(o => ...)`. The idiomatic way
    // to ask "does any element of this small list match a condition" is
    // a bounded recursive helper. `offerings` is a short, admin-curated
    // list (a handful of entries per service), so a fixed small bound is
    // safe and avoids Firestore Rules' lack of general loops/recursion
    // limits from becoming a real constraint here.
    function _offeringMatches(offerings, idx, offeringId) {
      return idx < offerings.size()
        && offerings[idx].id == offeringId
        && offerings[idx].isAvailable == true;
    }
    function _anyOfferingBookable(offerings, offeringId) {
      return (offerings.size() > 0 && _offeringMatches(offerings, 0, offeringId))
        || (offerings.size() > 1 && _offeringMatches(offerings, 1, offeringId))
        || (offerings.size() > 2 && _offeringMatches(offerings, 2, offeringId))
        || (offerings.size() > 3 && _offeringMatches(offerings, 3, offeringId))
        || (offerings.size() > 4 && _offeringMatches(offerings, 4, offeringId))
        || (offerings.size() > 5 && _offeringMatches(offerings, 5, offeringId))
        || (offerings.size() > 6 && _offeringMatches(offerings, 6, offeringId))
        || (offerings.size() > 7 && _offeringMatches(offerings, 7, offeringId))
        || (offerings.size() > 8 && _offeringMatches(offerings, 8, offeringId))
        || (offerings.size() > 9 && _offeringMatches(offerings, 9, offeringId));
    }
    function offeringIsBookable(serviceId, offeringId) {
      let svc = get(/databases/$(database)/documents/services/$(serviceId)).data;
      return svc.isOpen == true
        && _anyOfferingBookable(svc.offerings, offeringId);
    }

    // Gap 7 (server-side): true if the student has NO existing
    // pending/confirmed booking on this service. Firestore rules can't
    // run a where()-filtered query against the bookings subcollection
    // directly, so — same technique as confirmedStudents/{uid} below —
    // this is backed by a small denormalized marker doc,
    // services/{serviceId}/activeBooking/{studentUid}, written/cleared
    // by serviceSync.js at the same time a booking becomes/stops being
    // active. A missing marker means "no active booking"; its mere
    // existence (not its contents) is the signal, mirroring
    // confirmedStudents' own existence-only shape.
    function hasNoActiveBooking(serviceId, studentUid) {
      return !exists(/databases/$(database)/documents/services/$(serviceId)/activeBooking/$(studentUid));
    }

    match /services/{serviceId} {
      // read: open to any signed-in user — the student-facing Services
      // list (§6) needs to read isOpen/offerings/etc for every service,
      // and there's nothing sensitive in a service's own listing itself
      // (no customer data lives here, only the provider's own catalog).
      allow read: if isSignedIn();

      // Create: only a VERIFIED provider, and only for themselves
      // (providerUid must equal their own uid) — an unverified or
      // rejected provider account can never create a service doc, which
      // is the actual hard-gate enforcement point (RequireProvider in
      // App.jsx is a UI convenience; this rule is what actually matters).
      allow create: if isSignedIn()
        && isVerifiedProviderUid(request.auth.uid)
        && request.resource.data.providerUid == request.auth.uid
        && request.resource.data.isOpen == false
        && request.resource.data.revenueTotal == 0;

      // Update: the owning provider can edit their own service (details,
      // isOpen toggle, offerings) — Founder can also edit/deactivate
      // (e.g. force isOpen: false alongside providers/{uid}.status ->
      // 'deactivated', Gap 9). providerUid and revenueTotal are
      // deliberately excluded from what a plain provider update can
      // touch: providerUid must never change hands, and revenueTotal
      // must only ever move via the transaction in finishBooking()
      // touching a booking + the service together — a provider directly
      // rewriting their own revenueTotal upward is exactly the kind of
      // self-reported number this app never trusts elsewhere either.
      allow update: if (isSignedIn() && resource.data.providerUid == request.auth.uid
          && request.resource.data.providerUid == resource.data.providerUid
          && request.resource.data.revenueTotal == resource.data.revenueTotal)
        || isAdmin();

      allow delete: if isAdmin();

      // -----------------------------------------------------------
      // bookings/{bookingId} — the state machine itself (§7). Every
      // transition below is enforced here, not just trusted from the
      // client, since a booking's status directly gates whether the
      // provider's phone/customer details are meaningful and whether
      // revenue gets counted.
      // -----------------------------------------------------------
      match /bookings/{bookingId} {
        // read: the booking's own student, or the service's owning
        // provider, or the Founder. Students can never read each other's
        // bookings (§10) — this is the enforcement point for that.
        allow read: if isSignedIn()
          && (resource.data.studentUid == request.auth.uid || ownsService(serviceId) || isAdmin());

        // Create: any signed-in student, for themselves only, always
        // starting in 'pending' with every other terminal/derived field
        // at its zero value. Gap 5 (offering must be open+available) and
        // Gap 7 (one active booking per service) used to be client-side
        // only in serviceSync.js's createBooking() — now re-verified
        // here too via offeringIsBookable()/hasNoActiveBooking(), so a
        // modified client can no longer slip a booking past a closed
        // shop, a disabled offering, or a second active booking on the
        // same service. This closes the gap PROGRESS.md flagged at the
        // end of Phase 2.
        allow create: if isSignedIn()
          && request.resource.data.studentUid == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.cancelledBy == null
          && request.resource.data.confirmedSlot == null
          && offeringIsBookable(serviceId, request.resource.data.offeringId)
          && hasNoActiveBooking(serviceId, request.auth.uid);

        // Update: exactly the transitions in §7, nothing else.
        allow update: if isSignedIn() && (
          // pending -> confirmed (owner only) — status + confirmedSlot only.
          (ownsService(serviceId)
            && resource.data.status == 'pending'
            && request.resource.data.status == 'confirmed'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'confirmedSlot']))

          // pending -> expired_shop_closed (owner only, via the shop-close
          // auto-expire batch in setServiceOpen()) — status only.
          || (ownsService(serviceId)
            && resource.data.status == 'pending'
            && request.resource.data.status == 'expired_shop_closed'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))

          // pending/confirmed -> cancelled (Gap 1, Gap 3) — either the
          // booking's own student OR the owning provider, each only
          // ever stamping their OWN identity into cancelledBy (a student
          // can't cancel and blame it on 'owner', and vice versa).
          || (resource.data.studentUid == request.auth.uid
            && (resource.data.status == 'pending' || resource.data.status == 'confirmed')
            && request.resource.data.status == 'cancelled'
            && request.resource.data.cancelledBy == 'student'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledBy']))
          || (ownsService(serviceId)
            && (resource.data.status == 'pending' || resource.data.status == 'confirmed')
            && request.resource.data.status == 'cancelled'
            && request.resource.data.cancelledBy == 'owner'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledBy']))

          // confirmed -> done (owner only) — status only; revenueTotal
          // moves on the SIBLING services/{serviceId} doc in the same
          // transaction, not on the booking itself.
          || (ownsService(serviceId)
            && resource.data.status == 'confirmed'
            && request.resource.data.status == 'done'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        );

        // Terminal states (done/cancelled/expired_shop_closed) have no
        // further transitions — the update rule above already excludes
        // them implicitly (none of its five branches match a resource
        // whose current status isn't 'pending' or 'confirmed'), so no
        // separate denial clause is needed.

        allow delete: if isAdmin();
      }

      // -----------------------------------------------------------
      // confirmedStudents/{uid} — Phase 3 Part 2 addition (§10). A tiny
      // existence-only marker doc ({exists} — no fields needed) written
      // by confirmBooking() the moment a booking reaches 'confirmed',
      // and left in place through 'done' (never removed on finish —
      // §10's "once confirmed" reveal is a one-way gate, a student who
      // legitimately saw the number for a completed booking doesn't lose
      // that standing retroactively). Removed only if the booking is
      // later cancelled with no other confirmed/done booking from the
      // same student remaining (see removeConfirmedStudentMarkerIfNoneLeft
      // in serviceSync.js).
      //
      // Exists purely so providers/{uid}/contact/phone's read rule
      // (hasConfirmedBookingWithProvider, above) has a cheap, single
      // exists() check to gate on — Firestore rules can't run a
      // where()-filtered query to ask "does this student have ANY
      // confirmed booking on this service" directly, so this marker doc
      // is the denormalized answer to exactly that question.
      match /confirmedStudents/{studentUid} {
        allow read: if isSignedIn()
          && (request.auth.uid == studentUid || ownsService(serviceId) || isAdmin());
        // Write: only the owning provider (confirmBooking/cancelBooking
        // both run as the owner's action when they cause this marker to
        // appear/disappear) — a student can never write their own
        // "I have a confirmed booking" marker, which would defeat the
        // entire point of gating the phone number on it.
        allow write: if ownsService(serviceId);
      }

      // -----------------------------------------------------------
      // activeBooking/{studentUid} — existence-only marker backing
      // Gap 7's server-side enforcement (hasNoActiveBooking() above).
      // Written by the STUDENT themselves at the same moment their
      // booking create succeeds (same batch, so the two can never go
      // out of sync from the student's own action), and cleared by
      // whichever party causes the booking to leave the
      // pending/confirmed state (student cancel, owner cancel, owner
      // confirm->done, or the shop-close auto-expire batch) — see
      // serviceSync.js's createBooking/cancelBooking/finishBooking/
      // expirePendingBookingsForClosedShop for the write sites.
      //
      // Unlike confirmedStudents (owner-only write, since it gates a
      // privacy-sensitive reveal), this marker's create is student-
      // written — it has to be, since createBooking() itself is a
      // student action and the whole point is blocking that SAME
      // create from happening twice. The security property that
      // matters isn't "who can write this marker" but "can a student
      // create a second active booking while the marker exists" — and
      // hasNoActiveBooking() already blocks that regardless of who
      // holds write access to the marker itself.
      match /activeBooking/{studentUid} {
        allow read: if isSignedIn()
          && (request.auth.uid == studentUid || ownsService(serviceId) || isAdmin());
        allow create: if isSignedIn() && request.auth.uid == studentUid;
        allow delete: if isSignedIn()
          && (request.auth.uid == studentUid || ownsService(serviceId) || isAdmin());
        allow update: if false; // existence-only — never modified, only created/deleted
      }
    }

    // -------------------------------------------------------------
    // bookingAlerts/{uid}/items/{alertId} — Phase 3 Part 2 (§9). Per-
    // recipient booking notifications (confirmed / cancelled / shop-closed
    // expiry), read by NotificationPanel.jsx alongside notices/alerts.
    //
    // Mirrors users/{uid}/data/{key}'s ownership shape (owner-only
    // read/write) but as its own top-level collection instead of living
    // in that generic bucket, since these are system-generated events
    // written by serviceSync.js on the OTHER party's behalf (a student
    // cancelling writes an alert into the PROVIDER's bookingAlerts, and
    // vice versa) — not user-authored key/value data the owner writes for
    // themselves. That's why write here is scoped to "whoever legitimately
    // has standing to report a booking event about this uid" rather than
    // "the uid itself", the same way bookings/{bookingId}'s own update
    // rule above scopes each transition to the specific party who is
    // allowed to cause it.
    // -------------------------------------------------------------
    match /bookingAlerts/{uid}/items/{alertId} {
      // Read: owner only — this is that person's own notification inbox.
      allow read: if isSignedIn() && request.auth.uid == uid;

      // Update: owner only, and only to flip read:true (marking as seen
      // from NotificationPanel.jsx) — no other field may change once
      // written.
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

      // Create: the alert's recipient (uid) must be either the booking's
      // own student or the owning provider of the referenced service —
      // i.e. exactly the two parties who could legitimately know about
      // and report this booking event, same pairing bookings/{bookingId}'s
      // cancel rule already enforces. This still allows a student to
      // write into a PROVIDER's bookingAlerts (cancelling their own
      // booking alerts the provider) and vice versa — that cross-write is
      // the whole point (§9: alert the *other* party) — but blocks a
      // request faking an alert for an uninvolved third uid, or claiming
      // an event on a booking/service that doesn't exist or doesn't match.
      allow create: if isSignedIn()
        && request.resource.data.kind in ['booking_confirmed', 'booking_cancelled', 'booking_expired']
        && request.resource.data.read == false
        && exists(/databases/$(database)/documents/services/$(request.resource.data.serviceId)/bookings/$(request.resource.data.bookingId))
        && (
          get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)/bookings/$(request.resource.data.bookingId)).data.studentUid == uid
          || get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.providerUid == uid
        );

      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // -------------------------------------------------------------
    // Blood Bank directory — bloodDonors/{uid}. Separate top-level
    // collection (not part of users/{uid}/data, which is owner-read-only
    // and therefore not queryable across all students) so the Founder can
    // search "who has blood group X" via bloodDonorSync.js's
    // searchBloodDonorsByGroup(). Mirrors the faculty/{uid} directory
    // pattern: small doc (name/roll/dept/bloodGroup only, never the full
    // profile), write restricted to the owning REAL account (anonymous
    // sessions can't create a searchable directory entry — same
    // rationale as isRealAccount()'s Classmates/CR restriction above),
    // read open to any signed-in user since this is exactly the kind of
    // info that's meant to be found by someone else in an emergency.
    // Deletion is allowed by the owner too — bloodDonorSync.js removes
    // the doc entirely if bloodGroup is cleared, rather than leaving a
    // blank one behind.
    // -------------------------------------------------------------
    match /bloodDonors/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isRealAccount() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'studentId', 'dept', 'bloodGroup'])
        && request.resource.data.bloodGroup in ['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-'];
      allow delete: if isRealAccount() && request.auth.uid == uid;
    }

    // -------------------------------------------------------------
    // Records that a person proved ownership of a *.kuet.ac.bd mailbox via
    // the magic-link flow (facultyEmailVerify.js) — this is evidence an
    // Admin can see, NOT an auto-verification switch. It does not, by
    // itself, set faculty/{uid}.verifiedAt (see that match block above);
    // only an Admin clicking Verify in the Faculty → Pending tab does.
    // -------------------------------------------------------------
    match /verifiedFacultyEmails/{email} {
      allow read: if isSignedIn();
      allow write: if isSignedIn(); // the secondary app's own authenticated session
    }

    // -------------------------------------------------------------
    // Roll unlock requests — fallback for when the requester has no
    // verifiedRolls proof to auto-reclaim with (see rollOwnership.js
    // requestRollUnlock()). Founder/admin resolves these directly from
    // StaffDashboard; no outside contact channel needed.
    // -------------------------------------------------------------
    match /rollUnlockRequests/{requestId} {
      allow read: if isAdmin() || isHeadOfOps()
        || (isSignedIn() && resource.data.requestedBy == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.requestedBy == request.auth.uid;
      allow update: if isAdmin() || isHeadOfOps();
      allow delete: if false;
    }

    // -------------------------------------------------------------
    // Manual verification requests — fallback path when automatic KUET
    // email verification can't send (ManualVerifyFallback.jsx / see
    // manualVerifyRequests.js header). Same shape/spirit as
    // rollUnlockRequests just above: requester creates their own doc,
    // Founder/admin resolves it from the Approvals tab.
    //
    // BUGFIX: this collection previously had NO rule block at all —
    // Firestore rules are default-deny per collection, so every
    // addDoc() here (the "Contact Founder on WhatsApp" button) was
    // silently rejected with permission-denied for EVERY user, signed
    // in or anonymous, not just in incognito. The WhatsApp deep-link
    // itself never even opened, since ManualVerifyFallback only calls
    // window.open() *after* the Firestore write succeeds (see its
    // handleSend) — so the failed write silently blocked the WhatsApp
    // fallback along with it, in every browser/mode, every time.
    // -------------------------------------------------------------
    match /manualVerifyRequests/{requestId} {
      allow read: if isAdmin() || isHeadOfOps()
        || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin() || isHeadOfOps();
      allow delete: if false;
    }

    // -------------------------------------------------------------
    // Question Bank upload requests — Campus Lead uploads a paper for
    // their OWN dept+batch group; routes to that dept's Senior Campus
    // Lead for approval, same universal-fallback shape as clApplications
    // (SCL vacant -> Head of Ops/Founder still sees & can act on it).
    // The actual PDF bytes live in Cloudflare R2 (staging/ then public/),
    // NOT in Firestore/Storage — this doc is only the review-queue record
    // the Worker's /approve and /reject endpoints key off of.
    // -------------------------------------------------------------
    match /qbUploadRequests/{requestId} {
      allow read: if isAdmin() || isHeadOfOps()
        || (isSignedIn() && isSCLFor(resource.data.dept))
        || (isSignedIn() && resource.data.uploadedBy == request.auth.uid);

      // Founder can create for ANY dept (bypasses the group-scope check —
      // matches isAdmin() short-circuiting everywhere else in this file),
      // AND writes the doc pre-approved (status: 'approved') since Founder
      // uploads skip review entirely — see qbUploadRequests.js's
      // isFounderUpload flag. Everyone else: must be the Campus Lead of
      // the exact group they're claiming to upload for, dept/groupId must
      // actually agree, and the doc must start life as 'pending' (only a
      // reviewer's later update can move it to 'approved').
      allow create: if isSignedIn() && request.resource.data.uploadedBy == request.auth.uid
        && (
          (isAdmin() && request.resource.data.status == 'approved')
          || (
            request.resource.data.status == 'pending'
            && request.resource.data.groupId == expectedGroupId(request.resource.data)
            && isCLFor(request.resource.data.groupId)
          )
        );

      // Review authority: Founder, Head of Ops, or the SCL of this request's
      // dept. Founder's own uploads are written pre-approved by the client
      // (status: 'approved' at create time) so they never need a second
      // reviewer to touch this path at all — see qbUploadRequests.js.
      allow update: if isAdmin() || isHeadOfOps() || isSCLFor(resource.data.dept);

      allow delete: if false; // audit trail — resolve via status, never delete
    }

    // -------------------------------------------------------------
    // Question Bank DELETE requests — a Campus Lead can never remove a
    // LIVE public paper directly (see qbUploadRequests above for how it
    // got published in the first place); they can only request removal.
    // Only Founder or Head of Ops may action the request — deliberately
    // narrower than qbUploadRequests' approve authority (no SCL here),
    // matching the Worker's handleDeletePublicObject auth check.
    //
    // Each item in `items[]` carries the FULL R2 object key (not just a
    // filename) so the Founder/Head-of-Ops review UI shows exactly which
    // file is about to be deleted, with no ambiguity — this doc is only
    // the review-queue record; the Worker's DELETE /public-object is what
    // actually removes the R2 object once approved, same "Firestore doc
    // is the record, Worker call is the effect" split as qbUploadRequests.
    // -------------------------------------------------------------
    match /deleteRequests/{requestId} {
      allow read: if isAdmin() || isHeadOfOps()
        || (isSignedIn() && resource.data.requestedBy == request.auth.uid);

      // Only a Campus Lead of the group they claim may create a request,
      // and it must start life as 'pending' — same shape as
      // qbUploadRequests' create rule.
      // Allows either the CL of the exact group, OR the SCL of that
      // dept — an SCL oversees the whole dept (all sections) and may
      // have no personal CL role of their own (see QuestionBank.jsx's
      // canManageDept/myGroupIdForDept, which already lets an SCL-only
      // user see and use the "Request deletion" action; without this
      // isSCLFor() branch that UI path would be rejected here every
      // time).
      allow create: if isSignedIn() && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && (isCLFor(request.resource.data.groupId) || isSCLFor(request.resource.data.dept));

      // Only Founder/Head of Ops may action a request — the requesting CL
      // has no update path here at all (mirrors "CL must NOT be able to
      // update status themselves").
      allow update: if isAdmin() || isHeadOfOps();

      allow delete: if false; // audit trail — resolve via status, never delete
    }

    // -------------------------------------------------------------
    // Roll ownership lock — see rollOwnership.js. One durable doc per
    // roll number so two different accounts can't both claim the same
    // student roll. First account to save with that roll owns it.
    // -------------------------------------------------------------
    match /rollOwners/{roll} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      // Normal update: owner refreshing their own claim.
      // Reclaim update: a DIFFERENT account may take over this roll's
      // ownership doc ONLY if it has already proven institutional
      // ownership of the matching KUET email (verifiedRolls/{roll}
      // exists) — see rollOwnership.js claimRoll() and
      // kuetEmailVerify.js. That proof outranks a stale/mistaken prior
      // claim by construction, since verifiedRolls itself is only ever
      // written by a session that genuinely controlled that mailbox.
      allow update: if isSignedIn() && request.resource.data.uid == request.auth.uid &&
        (resource.data.uid == request.auth.uid ||
         exists(/databases/$(database)/documents/verifiedRolls/$(roll)));
      // Owner can release their own claim (e.g. switching accounts).
      // Admin/Founder can also clear a stuck/duplicate claim manually.
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // -------------------------------------------------------------
    // Founder (single owner) — manually provisioned, never client-writable
    // -------------------------------------------------------------
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // -------------------------------------------------------------
    // Official staff hierarchy (Head of Ops, Core Team leads, SCL, CL)
    // -------------------------------------------------------------
    // Collection-group read for the 'roles' subcollection. Firestore
    // requires this as a SEPARATE rule from the nested match below — a
    // normal match /staff/{targetUid}/roles/{roleId} rule only covers
    // direct-path reads, never a collectionGroup('roles') query, which
    // is what listStaffByRole() in staffSync.js actually issues (used by
    // both the Founder's "current role holders" view and Head of Ops's
    // SCL list). Without this, every such query is rejected outright —
    // regardless of who's asking — which is why the Founder dashboard
    // was showing 0 holders for every role even with real CL/SCL data
    // in the database. Scoped to the same two roles already granted
    // unconditional per-document read access below (isAdmin/isHeadOfOps);
    // this does not widen anyone's actual access, it only makes that
    // already-intended access work for this query shape.
    match /{path=**}/roles/{roleId} {
      allow read: if isAdmin() || isHeadOfOps();
    }

    // Collection-group read for 'members', scoped to Admin/Head of Ops
    // only (narrower than the roles one above — member docs carry name/
    // roll/email across every class, so this is real PII breadth, not
    // just role metadata). Used by the Founder's "Staff & Roles" view to
    // resolve a global staff-role holder's uid into a display name/roll,
    // since staff/{uid}/roles/{roleId} itself stores neither (see
    // getStaffDisplayInfo in staffSync.js).
    match /{path=**}/members/{memberUid} {
      allow read: if isAdmin() || isHeadOfOps();
    }

    match /staff/{targetUid}/roles/{roleId} {
      allow read: if isAdmin() || isHeadOfOps() || request.auth.uid == targetUid
        // Senior Campus Leads need to see the Campus Leads in their own
        // department in StaffDashboard; this is a scoped read, not global
        // staff visibility.
        || (resource.data.role == 'campus_lead' && (
          (resource.data.scope.type == 'dept' && isSCLFor(resource.data.scope.dept))
          || (resource.data.scope.type == 'group' && isSCLForGroup(resource.data.scope.groupId))
        ));

      // Appointment authority:
      //  - Founder can assign anyone, anything.
      //  - Head of Ops can appoint Senior Campus Leads and Campus Leads.
      //  - A department's Senior Campus Lead can appoint that dept's Campus Leads.
      allow create: if isAdmin()
        || (isHeadOfOps() && request.resource.data.role in ['senior_campus_lead', 'campus_lead'])
        || (request.resource.data.role == 'campus_lead'
            && request.resource.data.scope.type == 'group'
            && isSCLForGroup(request.resource.data.scope.groupId));

      // Removal authority is intentionally asymmetric (Manifesto §6):
      //  - Founder can remove anyone.
      //  - Head of Ops can remove Campus Leads (even ones an SCL appointed —
      //    accountability check on the SCL layer).
      //  - Senior Campus Leads CANNOT remove Campus Leads themselves.
      allow delete: if isAdmin()
        || (isHeadOfOps() && resource.data.role in ['senior_campus_lead', 'campus_lead']);

      allow update: if isAdmin(); // reassigning reportsTo etc. — Founder only, keep simple
    }

    // Append-only audit trail of staff role assign/revoke events (see
    // logRoleHistoryEntry in staffSync.js). Read access mirrors the roles
    // rule directly above: Admin/Head of Ops see everyone's, a person can
    // see their own. Writes only ever come from assignRole/removeRole
    // (both Admin/Head-of-Ops/SCL-gated by the roles rule above already),
    // so create is scoped the same way — no update/delete, entries are
    // permanent once written.
    match /staffRoleHistory/{entryId} {
      allow read: if isAdmin() || isHeadOfOps() || request.auth.uid == resource.data.uid;
      allow create: if isAdmin()
        || (isHeadOfOps() && request.resource.data.role in ['senior_campus_lead', 'campus_lead'])
        || (request.resource.data.role == 'campus_lead'
            && request.resource.data.scope.type == 'group'
            && isSCLForGroup(request.resource.data.scope.groupId));
      allow update, delete: if false;
    }

    // Denormalized vacancy markers so rules/clients can check "is this
    // dept/group covered" without a collectionGroup scan.
    match /depts/{dept}/meta/sclStatus {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || isHeadOfOps();
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // Campus Lead applications — routes to that dept's SCL (or Head of
    // Ops/Founder directly if the SCL post is vacant).
    // -------------------------------------------------------------
    match /clApplications/{applicationId} {
      allow read: if isAdmin() || isHeadOfOps()
        || (isSignedIn() && isSCLFor(resource.data.dept))
        || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid
        // dept/batch/groupId must actually agree with each other — no
        // claiming leadership of one class while citing another's dept.
        && request.resource.data.groupId == expectedGroupId(request.resource.data)
        // and the applicant must be a real, legitimate member of that
        // exact class already (verified manually, or via a Tier-1
        // matching KUET email) — not a total stranger to it.
        && (isVerifiedMember(request.resource.data.groupId)
            || (rollIsInstitutionallyVerified(request.resource.data.roll)
                && rollMatchesGroup(request.resource.data.roll, request.resource.data.groupId)));
      allow update: if isAdmin() || isHeadOfOps() || isSCLFor(resource.data.dept);
      allow delete: if false;
    }

    // -------------------------------------------------------------
    // Email flags — manual, human-reviewed flags on EXISTING accounts
    // whose registered email looks fake/invalid (see emailFlags.js).
    // NOT an automatic ban: this only lets the right person raise a flag;
    // the account itself is untouched (no delete, no lockout) until the
    // owner responds via the in-app banner.
    //
    // Authority (same hierarchy as staff roles):
    //  - Campus Lead of the target's own group.
    //  - Senior Campus Lead of the target's dept.
    //  - Head of Ops / Founder — always, and this is also the fallback
    //    used when a dept/group's SCL/CL post is vacant, since those two
    //    roles pass the check unconditionally regardless of vacancy.
    //  - The flagged user themself can always read their own flag (so
    //    their banner can show it) but can never write/resolve it.
    // -------------------------------------------------------------
    // canFlagEmail checks the ACTOR's authority over a scope; it does
    // NOT by itself confirm the TARGET actually belongs to that scope.
    // Call sites must separately require targetIsGroupMember(targetUid,
    // groupId) — see emailFlags/{targetUid} create below — otherwise
    // any CL/SCL could flag an arbitrary uid outside their own class by
    // simply claiming their own groupId/dept in the flag payload, since
    // nothing here reads the target's actual membership.
    function canFlagEmail(dept, groupId) {
      return isAdmin() || isHeadOfOps()
        || (groupId != null && isCLFor(groupId))
        || (dept != null && isSCLFor(dept));
    }
    match /emailFlags/{targetUid} {
      allow read: if isAdmin() || isHeadOfOps() || request.auth.uid == targetUid
        || (resource.data.groupId != null && isCLFor(resource.data.groupId))
        || (resource.data.dept != null && isSCLFor(resource.data.dept));
      // create: must be shaped as a fresh, pending flag on the correct
      // doc id, by someone with authority over the scope THEY claim in
      // the doc (not a scope they'll later widen — update below can't
      // touch dept/groupId, so this is the only place scope is ever
      // set). request.resource.data.targetUid == targetUid stops
      // writing a flag under one uid's doc while pointing it at
      // another uid's data, which would let a flag "belong" to the
      // wrong owner's read grant.
      //
      // targetIsGroupMember(...) closes a separate gap: without it, a
      // CL/SCL genuinely holding authority over THEIR OWN group/dept
      // could still flag any arbitrary uid in the whole app — nothing
      // otherwise confirms the target is actually IN that group/dept.
      // Admin/Head of Ops are exempt from this extra check since their
      // authority is already global and not scope-claimed. When a
      // groupId is present the target must be a member of exactly that
      // group; the isAdmin()/isHeadOfOps() path is only skipped when
      // groupId is actually null (a dept-only flag from an SCL that has
      // no specific groupId to check against — dept-wide membership
      // isn't a single list we can cheaply verify here, so that narrow
      // case still relies on canFlagEmail's role check alone, same as
      // before).
      allow create: if isSignedIn() &&
        request.resource.data.targetUid == targetUid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.flaggedBy == request.auth.uid &&
        canFlagEmail(request.resource.data.dept, request.resource.data.groupId) &&
        (isAdmin() || isHeadOfOps()
          || request.resource.data.groupId == null
          || targetIsGroupMember(targetUid, request.resource.data.groupId));
      // update: authority is checked against the EXISTING (resource)
      // scope, same as before — but the write itself is now restricted
      // to only status/resolvedBy/resolvedAt/reason. dept and groupId
      // can never change after creation, which closes the scope-
      // escalation gap where a CL could otherwise widen a flag's
      // groupId/dept on update to one outside their own authority, or
      // where status could be bounced back to 'pending' by anyone
      // after a legitimate resolve. targetUid/flaggedBy/flaggedAt are
      // likewise immutable history, not editable fields.
      allow update: if (isAdmin() || isHeadOfOps()
          || (resource.data.groupId != null && isCLFor(resource.data.groupId))
          || (resource.data.dept != null && isSCLFor(resource.data.dept)))
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'resolvedBy', 'resolvedAt', 'reason'])
        && (request.resource.data.status == 'pending'
            || request.resource.data.status == 'resolved'
            || request.resource.data.status == 'dismissed');
      allow delete: if isAdmin() || isHeadOfOps();
    }

    // -------------------------------------------------------------
    // Global (Founder / Head of Ops) notices — flexible audience.
    // -------------------------------------------------------------
    match /notices/{noticeId} {
      // TODO (Phase 5 item 5, deferred): pure Firestore rules can't do
      // time-window rate limiting (rules are stateless — there's no way
      // to count "how many notices has this uid created in the last 5
      // minutes" from within a rule). If notice spam becomes a real
      // problem, the fix is a Cloud Function onCreate trigger on this
      // collection (and on groups/{groupId}/notices) that maintains a
      // per-sender rolling counter (e.g. in a separate rateLimits/{uid}
      // doc) and rejects/flags a create past some max-N-per-5-min
      // threshold. Not implemented — the length cap below and the UI
      // role-gates (see ClassRoster.jsx) are the urgent items for now.
      // Audit fix — privacy-critical: this used to be a blanket
      // `allow read: if isSignedIn()` for EVERY root notice, regardless
      // of its `audience` field — the exact same "client-side filtering
      // isn't a security boundary" gap Phase 5 already fixed for group
      // notices' targetType, just never fixed here. It was survivable
      // while `audience` only ever meant 'all' | 'batch' | 'group'
      // (nothing in those was individually sensitive — knowing "this
      // notice went to CSE 2K23" isn't a privacy leak). It stops being
      // survivable the moment individual targeting exists: a notice
      // addressed to one specific student or a specific set of faculty
      // (audience.type == 'student_uids' | 'faculty_uids') MUST NOT be
      // readable by anyone outside that uids list via a raw SDK query,
      // even though noticeAppliesTo() in groupSync.js already hides it
      // from them client-side. Gated per audience.type:
      //   - 'all'                    → anyone signed in (unchanged)
      //   - 'batch' | 'group'        → anyone signed in — population-
      //     level targeting only, not individually sensitive; the
      //     student-side UI already narrows by noticeAppliesTo(), same
      //     as before this fix (batch/group membership isn't secret)
      //   - 'faculty_all'            → any verified faculty account
      //   - 'faculty_uids'           → only a faculty account whose OWN
      //     uid is in the notice's own uids array
      //   - 'student_uids'           → only a signed-in user whose OWN
      //     uid is in the notice's own uids array
      //   - anything else/missing    → Admin/HeadOfOps only (fail closed,
      //     not open — an audience shape this rule doesn't recognize
      //     should never default to "everyone can read it")
      allow read: if isAdmin() || isHeadOfOps() || (isSignedIn() && (
        resource.data.audience.type == 'all'
        || resource.data.audience.type == 'batch'
        || resource.data.audience.type == 'group'
        || (resource.data.audience.type == 'faculty_all' && isFaculty(request.auth.uid))
        || (resource.data.audience.type == 'faculty_uids' && isFaculty(request.auth.uid)
            && request.auth.uid in resource.data.audience.uids)
        || (resource.data.audience.type == 'student_uids'
            && request.auth.uid in resource.data.audience.uids)
      ));
      // Phase 5 of the Notice upgrade (Security Hardening): create is
      // now split out from update/delete so the length cap below only
      // applies when a NEW notice is being written — an update (e.g. the
      // Phase 2 soft-delete, which merge-writes only { deleted: true })
      // doesn't necessarily carry title/body in its own resource.data in
      // every SDK code path, so gating update on those fields too could
      // wrongly break soft-delete. Admin/HeadOfOps keep unconditional
      // access to all three operations, same as before.
      allow create: if (isAdmin() || isHeadOfOps())
        && request.resource.data.title is string && request.resource.data.title.size() < 200
        && request.resource.data.body is string && request.resource.data.body.size() < 5000
        // Individual/small-group targeting (audience.type in
        // 'student_uids'/'faculty_uids'): the uids array IS the access
        // list the read rule above checks against, so it's validated at
        // write time too — must actually be a list of strings, and
        // capped at 300 (a single Firestore array-membership check like
        // `auth.uid in audience.uids` is cheap regardless of length, but
        // there's no product reason for a "specific people" notice to
        // ever address hundreds at once — that's what 'batch'/'group'/
        // 'all' are for; a huge uids array is almost certainly a UI bug,
        // not a real targeted send).
        && (!('audience' in request.resource.data)
            || !(request.resource.data.audience.type in ['student_uids', 'faculty_uids'])
            || (request.resource.data.audience.uids is list
                && request.resource.data.audience.uids.size() > 0
                && request.resource.data.audience.uids.size() <= 300));
      allow update, delete: if isAdmin() || isHeadOfOps();

      // Read-receipts (Phase 0 of the Notice upgrade). Each signed-in
      // user marks their OWN read doc only (doc id == their own uid) —
      // never someone else's. Only the sender (createdBy.uid) or an
      // Admin/HeadOfOps can read the full reads list back, so students
      // can never see each other's read status (privacy).
      match /reads/{uid} {
        allow create, update: if isSignedIn() && request.auth.uid == uid
          && request.auth.uid == request.resource.data.uid;
        allow read: if isAdmin() || isHeadOfOps()
          || (isSignedIn() && get(/databases/$(database)/documents/notices/$(noticeId)).data.createdBy.uid == request.auth.uid);
        allow delete: if false;
      }
    }

    // -------------------------------------------------------------
    // App-wide config singletons (config/batches, etc.) — e.g. the
    // Founder-editable list of currently active batches shown in every
    // "Select batch" dropdown. Readable by anyone signed in (every
    // faculty Add Class flow needs it), writable only by Founder/Head of
    // Ops so the batch list can't be tampered with by a regular teacher
    // or student account.
    // -------------------------------------------------------------
    match /config/{configKey} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isHeadOfOps();
    }

    // -------------------------------------------------------------
    // Per-dept+batch class config (currently just termStartDate) —
    // see src/lib/termStartDateSync.js. Doc id is the same
    // `${batch}_${dept}` groupId used under /groups/{groupId}, kept as
    // a separate top-level collection (not nested under groups/) so a
    // student who isn't a verified group member yet can still read
    // their class's term start date at first-run onboarding.
    // Write restricted to that class's own CR/ACR (or Admin) — a CR in
    // one class must not be able to set another class's date.
    // -------------------------------------------------------------
    match /deptBatchConfig/{groupId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isGroupCR(groupId) || isGroupACR(groupId);
    }

    // -------------------------------------------------------------
    // Groups — batch+dept "class" community
    // -------------------------------------------------------------
    match /groups/{groupId} {
      allow read: if isAdmin() || isGroupMember(groupId) || isCLFor(groupId) || isSCLForGroup(groupId);
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();

      match /meta/clStatus {
        // BUGFIX: was isSignedIn() && (isAdmin() || isHeadOfOps() ||
        // isGroupMember(groupId) || isCLFor(groupId) || isSCLForGroup(groupId))
        // — that silently permission-denied checkCLVacant(groupId)
        // (staffSync.js) for the exact audience it exists to serve: a
        // non-member trying to bootstrap-claim CR on a brand-new class
        // with no CL/CR yet (ClaimCRCard.jsx's handleClaimCR). Since
        // checkCLVacant does a plain getDoc() (not onSnapshot), the
        // failure wasn't silent exactly — it surfaced as a generic
        // "Permission denied, try again" error to the user — but it was
        // NOT a transient race like that message implies; it would have
        // failed identically on every retry, permanently blocking the
        // one bootstrap path this whole CR-approval migration depends on
        // for a class that has nobody in authority yet. Read access to
        // "does a CL exist" is not sensitive — open it to any signed-in
        // user, same reasoning as the matching meta/crStatus fix above.
        allow read: if isSignedIn();
        allow create: if isAdmin() || isHeadOfOps() || isSCLForGroup(groupId);
        allow delete: if isAdmin() || isHeadOfOps(); // asymmetric, same as staff role removal above
        allow update: if isAdmin() || isHeadOfOps();
      }

      match /meta/crStatus {
        // BUGFIX: was isAdmin() || isGroupMember(groupId) || isCLFor(groupId)
        // — that silently permission-denied for anyone who ISN'T already a
        // member, which is exactly the audience that most needs to read
        // this (ClaimCRCard.jsx is shown to non-members precisely so they
        // can claim a vacant CR slot, and NoCRBanner.jsx needs this to
        // warn a non-member their class has no CR at all). Since
        // subscribeCRStatus's onSnapshot error callback only logs and
        // never calls back (see groupSync.js), that permission-denied
        // wasn't a visible error either — crStatus just silently stayed
        // null forever and both components rendered nothing, for every
        // signed-in non-member. This is just a count (hasCR/count/
        // slotsFull), not remotely sensitive — open it to any signed-in
        // user rather than gating read access at all.
        allow read: if isSignedIn();
        allow write: if isAdmin() || isCLFor(groupId) || isSCLForGroup(groupId) || isHeadOfOps();
      }

      // Shared Class Planner settings (courseTeacherMap + per-course plan
      // targets like plannedTotalClasses/perWeekTarget). Same authority as
      // routineEntries/assignmentEntries — any CR/ACR of the group can
      // read/write this single doc so co-CRs see the same targets instead
      // of siloed personal copies.
      match /meta/plannerSettings {
        allow read: if isAdmin() || isGroupMember(groupId);
        allow create, update: if isContentEditor(groupId);
        allow delete: if false;
      }

      match /members/{memberUid} {
        // Any faculty account, verified or not, can read "Students & CR"
        // for a class they're on — seeing a roster is harmless; the
        // manual verification gate is about actually teaching/writing
        // (creating an assignment, logging sessions, posting notices,
        // entering marks), not about read-only visibility.
        //
        // hasOwnJoinRequest(groupId): someone who has FILED a join
        // request (pending, approved, or rejected — any status) for this
        // group can also read the roster read-only. This is specifically
        // so a still-pending applicant can see who the current CR/ACR is
        // (JoinStatusCard.jsx's "who to bug" contact display) — without
        // this, subscribeMembers() permission-denies for exactly the
        // people who most need to know who to follow up with, and
        // _subscribeSingleton's retry-then-silently-empty fallback (see
        // groupSync.js) means that failure is invisible, not a visible
        // error, which is worse. Harmless to grant: same read-only roster
        // exposure isGroupMember already gets, just extended to "applied
        // but not yet approved" instead of requiring approval first.
        allow read: if isAdmin() || request.auth.uid == memberUid || isGroupMember(groupId) || isCLFor(groupId) || isHeadOfOps() || isSCLForGroup(groupId) || isFaculty(request.auth.uid)
          || (isSignedIn() && exists(/databases/$(database)/documents/groups/$(groupId)/joinRequests/$(request.auth.uid)));
        allow create:
                        // CR-join-request approval (approveJoinRequest in
                        // groupSync.js): CR/ACR/CL/Admin/HeadOfOps/SCL
                        // creates a brand-new member doc for SOMEONE ELSE,
                        // not a self-write. The old plain self-join branch
                        // (any real account writing role:'member' to their
                        // own uid) has been removed entirely — join is now
                        // request+approve only. This branch requires a
                        // matching joinRequests/{memberUid} doc that is
                        // currently 'pending' (still pending because this
                        // get() sees pre-batch state — approveJoinRequest's
                        // batch.update() to 'approved' hasn't landed yet
                        // when this create is evaluated) so this can't be
                        // used to add an arbitrary member with no request
                        // trail. isGroupCR/isGroupACR already prove the
                        // actor is an existing member of THIS group, same
                        // authority tier as the update rule's CR/ACR branch
                        // below.
                        if (isRealAccount()
                            && request.auth.uid != memberUid
                            && (isAdmin() || isCLFor(groupId) || isHeadOfOps() || isSCLForGroup(groupId)
                                || isGroupCR(groupId) || isGroupACR(groupId))
                            && request.resource.data.role == 'member'
                            && request.resource.data.verified == true
                            && exists(/databases/$(database)/documents/groups/$(groupId)/joinRequests/$(memberUid))
                            && get(/databases/$(database)/documents/groups/$(groupId)/joinRequests/$(memberUid)).data.status == 'pending')
                        // Fallback: approveCLApplication() bundles a CR
                        // appointment into the member doc as a set(merge:true).
                        // If the applicant's member doc somehow doesn't exist
                        // yet (e.g. no prior joinRequests approval, since
                        // there was nobody around to approve one — this is
                        // the CL-vacant bootstrap case), Firestore treats that
                        // merge as a CREATE, not an update — so without this,
                        // the whole approval would silently fail here even
                        // though the SCL/Admin/Head of Ops clearly has the
                        // authority to appoint CR (see the update rule below).
                        // Deliberately has NO joinRequests check — by
                        // definition there is no CR/ACR/CL yet to have
                        // received one. crCount(groupId) < 2 (MAX_CR):
                        // server-side capacity enforcement, mirroring the
                        // MAX_CR check groupSync.js already does client-side.
                        // Without this, a modified client (or any direct
                        // Firestore write bypassing the app's own JS) could
                        // grant unlimited 'cr' roles in one group, since
                        // nothing else in this rule file counts existing CR
                        // holders before allowing another.
                        || (request.resource.data.role == 'cr' && request.resource.data.verified == true
                            && (isAdmin() || isHeadOfOps() || isSCLForGroup(groupId))
                            && crCount(groupId) < 1);
        // Members edit only their own display fields. verified/role changes
        // are gated to CL/Admin/Head of Ops/that dept's SCL (fallback chain
        // — a request never gets stuck just because the immediate level is
        // vacant or unresponsive). The group's own CR/ACR also has a
        // narrow, field-restricted role-write power (see groupSync.js for
        // the exact app-level flows this backs):
        //   - CR can freely set role 'acr'<->'member' on anyone (assignACR/
        //     revokeACR) — no CL approval needed for that tier.
        //   - CR can set role 'member' on their OWN doc (the self-demote
        //     half of handoffCR) — always allowed, this only ever *frees*
        //     a CR slot, never creates unauthorized access.
        //   - CR can set role 'cr' on someone ELSE's doc — this is a
        //     handoff (see handoffCR in groupSync.js), where the acting
        //     CR replaces THEMSELF with a successor in the exact slot
        //     they already occupy. isGroupCR(groupId) already proves the
        //     acting user holds a CR slot, so this branch can never
        //     increase total CR count above MAX_CR by itself — it's a
        //     transfer, not a fresh appointment. (Firestore rules
        //     evaluate each doc in a batch independently, so this can't
        //     verify the acting CR ALSO demoted themself in the very same
        //     batch — but even in the worst case where they didn't, the
        //     result is one extra 'cr'-role doc that clRevokeCR/CL cleans
        //     up, not a bypass of CL approval for genuinely NEW CRs, since
        //     the target must already be an existing verified member, not
        //     an outside student being fast-tracked past a crRequests
        //     approval.)
        //   - ACR has none of this power (isGroupACR is deliberately
        //     absent from this branch).
        allow update: if isAdmin() ||
          ((isCLFor(groupId) || isHeadOfOps() || isSCLForGroup(groupId)) && request.auth.uid != memberUid
            // Capacity check, scoped narrowly: only applies when this
            // write is actually granting a FRESH 'cr' role to someone who
            // didn't already hold it (clAppointCR / clApproveCRRequest).
            // Re-saving an existing CR's doc, or any update that doesn't
            // touch role at all, is unaffected. Mirrors the client-side
            // MAX_CR check in groupSync.js so a modified client (or a
            // direct Firestore write) can't grant unlimited CR slots.
            && (request.resource.data.role != 'cr' || resource.data.role == 'cr' || crCount(groupId) < 1)) ||
          (isGroupCR(groupId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'verified', 'legacyCRClaim']) &&
            // legacyCRClaim may only ever be cleared here, never (re)set —
            // this branch is a same-slot handoff/step-down path, not a way
            // to grant the "Claims CR" flag to anyone.
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['legacyCRClaim']) ||
              request.resource.data.legacyCRClaim == false) &&
            (request.resource.data.role == 'acr' || request.resource.data.role == 'member' ||
             // A CR setting someone else to role 'cr' is a handoff — the
             // acting CR (isGroupCR already confirms this) is handing
             // over the exact slot they themself occupy. This never
             // changes total CR count (one CR replaced by another in the
             // same slot), so no extra capacity check is needed here —
             // unlike clAppointCR (CL action, genuinely fills an OPEN
             // slot), this branch is a same-slot transfer by definition
             // of who's allowed to trigger it.
             request.resource.data.role == 'cr')) ||
          (isSignedIn() && request.auth.uid == memberUid
            && request.resource.data.verified == resource.data.verified
            && request.resource.data.role == resource.data.role);
          // (Removed: the Tier-1 self-service "flip verified false->true"
          // catch-up branch. It was already unreachable in practice —
          // every members/{uid} create path sets verified:true immediately
          // — and both its client call sites (App.jsx, ClaimCRCard.jsx's
          // syncOwnVerification()) have been removed. verified is now only
          // ever set by a human CL/Faculty approval.)
        // Removal authority is asymmetric, same principle as the update
        // rule above: CL/Admin/Head of Ops can remove anyone. A group's
        // own CR/ACR can ALSO remove a plain member (kick from class) —
        // but never another CR/ACR outright (that must go through
        // clRevokeCR/CL escalation, not straight deletion) and never
        // themself via this path.
        //
        // Self-leave: a plain member (never a CR/ACR — they must step
        // down via handoffCR/requestLeaveCR first, so a class is never
        // left CR-less by a stray self-delete) may remove their OWN doc
        // at any time (leaveGroup in groupSync.js). Re-joining afterward
        // always requires a brand-new joinRequests approval — there is
        // no fast-path back in.
        allow delete: if isAdmin() || isCLFor(groupId) || isHeadOfOps() ||
          ((isGroupCR(groupId) || isGroupACR(groupId)) &&
            resource.data.role != 'cr' && resource.data.role != 'acr' &&
            request.auth.uid != memberUid) ||
          (isSignedIn() && request.auth.uid == memberUid && resource.data.role == 'member');
      }

      match /crRequests/{requestUid} {
        // Two kinds of docs share this collection: a fresh CR claim (doc id
        // == the requester's own uid, no `type` field) and a CR's own
        // "let me step down" leave request (doc id == 'leave_' + their
        // uid, type:'leave', with a `uid` field holding the real uid since
        // the doc id itself is no longer the plain uid). Both need CL
        // approval, so both share the same authority model below.
        allow read: if isAdmin() || isCLFor(groupId) || isHeadOfOps() || isSCLForGroup(groupId)
          || (isSignedIn() && request.auth.uid == requestUid)
          || (isSignedIn() && resource.data.uid == request.auth.uid);
        allow create: if isSignedIn() && isVerifiedMember(groupId) &&
          ((request.auth.uid == requestUid && request.resource.data.type != 'leave')
           || (request.resource.data.type == 'leave' && request.resource.data.uid == request.auth.uid
               && requestUid == 'leave_' + request.auth.uid && isGroupCR(groupId)));
        // Resubmission: setDoc() on an existing doc is an UPDATE to
        // Firestore, not a create — so once a request has been
        // approved/rejected, the requester needs their own update path
        // to send a fresh one, or they'd be silently locked out forever
        // after a single rejection. Only allowed from a resolved
        // (non-pending) prior state, resetting straight back to pending,
        // so a requester can never flip someone else's live pending
        // request or self-approve.
        //
        // Self-cancel: a requester may also move their OWN still-pending
        // request straight to 'revoked' (never 'approved' — that stays
        // CL/Admin-only). Needed so handoffCR can clean up a CR's pending
        // leave_{uid} request when they hand off directly instead of
        // waiting for CL sign-off, and so a "cancel my request" UI is
        // possible later without a rules change.
        allow update: if isAdmin() || isCLFor(groupId) || isHeadOfOps() || isSCLForGroup(groupId) ||
          (isSignedIn() && resource.data.status != 'pending' && request.resource.data.status == 'pending' &&
            ((request.auth.uid == requestUid && request.resource.data.type != 'leave')
             || (request.resource.data.type == 'leave' && request.resource.data.uid == request.auth.uid
                 && requestUid == 'leave_' + request.auth.uid && isGroupCR(groupId)))) ||
          (isSignedIn() && resource.data.status == 'pending' && request.resource.data.status == 'revoked' &&
            ((request.auth.uid == requestUid && resource.data.type != 'leave')
             || (resource.data.type == 'leave' && resource.data.uid == request.auth.uid)));
        allow delete: if false;
      }

      // -------------------------------------------------------------
      // Join requests — NEW class-membership gate (replaces plain
      // self-join). Doc id == requester's own uid, one per group.
      // Unlike crRequests (which requires already being a verified
      // member), a joinRequests doc is created by someone who is NOT
      // a member yet — that's the whole point, so it deliberately does
      // NOT call isGroupMember/isVerifiedMember as a precondition.
      //
      // contactEmail is a plain self-reported string field, shown only
      // to the CR/ACR/CL reviewing the request so THEY can eyeball
      // whether it looks like a real KUET address for that roll — it is
      // never verified by Firestore rules or any backend function.
      // There is no OTP/email-link step in this flow at all; the human
      // reviewer is the verifier, same trust model as a CR approving a
      // crRequests claim.
      match /joinRequests/{requestUid} {
        allow read: if isAdmin() || isCLFor(groupId) || isHeadOfOps() || isSCLForGroup(groupId)
          || isGroupCR(groupId) || isGroupACR(groupId)
          || (isSignedIn() && request.auth.uid == requestUid);
        allow create: if isRealAccount() && request.auth.uid == requestUid
          && request.resource.data.status == 'pending'
          && request.resource.data.uid == request.auth.uid
          && !isGroupMember(groupId);
        // Resubmission after a rejection: same shape as crRequests —
        // only the original requester can move their own resolved
        // (non-pending) doc back to pending, and only if they still
        // aren't a member (a rejected-then-approved-elsewhere edge case
        // shouldn't be reopenable here).
        allow update: if isAdmin() || isCLFor(groupId) || isHeadOfOps() || isSCLForGroup(groupId)
          || isGroupCR(groupId) || isGroupACR(groupId)
          || (isSignedIn() && request.auth.uid == requestUid
              && resource.data.status != 'pending' && request.resource.data.status == 'pending'
              && !isGroupMember(groupId));
        allow delete: if false;
      }

      match /routineEntries/{entryId} {
        allow read: if isAdmin() || isGroupMember(groupId) || isFaculty(request.auth.uid);
        allow create, update: if isContentEditor(groupId)
          && request.resource.data.updatedBy.uid == request.auth.uid;
        allow delete: if false; // soft-delete only, via update
      }

      match /assignmentEntries/{entryId} {
        allow read: if isAdmin() || isGroupMember(groupId);
        allow create, update: if isContentEditor(groupId)
          && request.resource.data.updatedBy.uid == request.auth.uid;
        allow delete: if false; // soft-delete only, via update
      }

      // Manual "+1" class-log entries for the Class Planner. One doc per
      // logged class (not an array-in-one-doc) so multiple CR/ACR logging
      // at the same time never collide — mirrors routineEntries/
      // assignmentEntries exactly.
      match /plannerLogEntries/{entryId} {
        // BUGFIX: was missing isFaculty(...) on read — Faculty's Sessions &
        // Count tab (FacultyClassDetail.jsx's SessionsTab) subscribes to
        // this same collection to show session logs/counts, but without
        // this the listener got "Missing or insufficient permissions" for
        // every faculty account, so `logs` stayed stuck at null (perpetual
        // loading) and the tab silently never rendered. Mirrors
        // routineEntries's read rule just above, which already has this.
        allow read: if isAdmin() || isGroupMember(groupId) || isFaculty(request.auth.uid);
        // A VERIFIED faculty account (manual verification policy — see
        // facultySessionSync.js's logFacultySession, which stamps
        // loggedBy: {uid, role:'faculty', name} on top of the same
        // updatedBy convention every other write in this collection
        // already uses) — the isContentEditor(groupId) branch (CR/ACR/
        // CL/Admin) is unchanged from before.
        allow create, update: if (isContentEditor(groupId) || isVerifiedFaculty(request.auth.uid))
          && request.resource.data.updatedBy.uid == request.auth.uid;
        allow delete: if false; // soft-delete only, via update
      }

      match /auditLog/{logId} {
        allow read: if isAdmin() || isCLFor(groupId) || isVerifiedMember(groupId);
        allow create: if isContentEditor(groupId) && request.resource.data.by.uid == request.auth.uid;
        allow update, delete: if false; // append-only
      }

      match /notices/{noticeId} {
        // Faculty can already CREATE here (isVerifiedFaculty, below) but
        // were missing from READ — isGroupMember(groupId) only recognizes
        // the student-side `members/{uid}` doc, so a faculty account
        // (verified or not — read-only visibility is harmless, same
        // reasoning as the /members read rule above) got permission-
        // denied on every notices listener for every class they teach.
        // That's the real cause behind the repeated
        // "[groupSync] listener error ... Missing or insufficient
        // permissions" loop for faculty accounts — not a startup race,
        // so the client-side retry backoff was never going to fix it.
        // Phase 5 of the Notice upgrade (Security Hardening): this used
        // to be a blanket isGroupMember(groupId) grant — any signed-in
        // member of the class could read every notice doc in this
        // subcollection directly via the Firestore SDK, including a
        // Teacher's cr_only notice, even though the CLIENT already hides
        // cr_only notices from non-CR/ACR viewers (see
        // filterStudentFacingNotices in noticeUtils.js). Client-side
        // filtering is a UI convenience, not a security boundary — a
        // student could always bypass it with a direct SDK query, since
        // the rule itself never checked targetType. Closed here: a
        // regular group member can read any notice EXCEPT one with
        // targetType == 'cr_only', which additionally requires being
        // CR/ACR in this group (or CL/Admin/Faculty, who already have
        // their own unconditional grant below).
        allow read: if isAdmin() || isFaculty(request.auth.uid) ||
          (isGroupMember(groupId) &&
           (resource.data.targetType != 'cr_only' ||
            isGroupCR(groupId) || isGroupACR(groupId) || isCLFor(groupId)));
        // Faculty notices REQUIRE the Blue Tick (isVerifiedFaculty) —
        // consistent with the rest of the manual verification policy: an
        // unverified faculty account cannot post into the notice feed.
        // The CR/ACR/CL/Admin branch is unchanged. Phase 5 of the Notice
        // upgrade added the title/body length cap — same limits as the
        // root /notices/{noticeId} create rule above, kept identical so
        // a sender doesn't hit a different cap depending on which of the
        // three composers they're using.
        allow create: if (isGroupCR(groupId) || isGroupACR(groupId) || isCLFor(groupId) || isAdmin() || isVerifiedFaculty(request.auth.uid))
          && request.resource.data.title is string && request.resource.data.title.size() < 200
          && request.resource.data.body is string && request.resource.data.body.size() < 5000;
        // Phase 2 of the Notice upgrade (Manage/Delete): a CR/ACR or
        // Teacher can now also soft-delete (or otherwise update) their
        // OWN notice — resource.data.postedBy.uid == request.auth.uid —
        // matching the sender-side "Delete" button in ClassRoster.jsx /
        // FacultyNoticeBroadcast.jsx. isCLFor(groupId)/isAdmin() keep
        // their existing unrestricted access (a CL/Admin can update or
        // soft-delete ANY notice in the group, not just their own).
        // Hard delete is still denied everywhere — soft-delete only, via
        // update (deleted: true), same pattern this file already uses
        // for resources/{resourceId} above.
        allow update: if isCLFor(groupId) || isAdmin()
          || (isSignedIn() && resource.data.postedBy.uid == request.auth.uid);
        allow delete: if false;

        // Read-receipts (Phase 0 of the Notice upgrade). Same shape and
        // same privacy rule as the root /notices/{noticeId}/reads above:
        // a member marks only their own read doc; only the notice's
        // sender (postedBy.uid), the group's CL, or Admin can read the
        // full list back.
        match /reads/{uid} {
          allow create, update: if isSignedIn() && request.auth.uid == uid
            && request.auth.uid == request.resource.data.uid;
          allow read: if isAdmin() || isCLFor(groupId)
            || (isSignedIn()
                && get(/databases/$(database)/documents/groups/$(groupId)/notices/$(noticeId)).data.postedBy.uid == request.auth.uid);
          allow delete: if false;
        }
      }

      // -----------------------------------------------------------
      // Faculty Module (§10 of the merged Faculty Module prompt).
      // -----------------------------------------------------------
      match /facultyAssignments/{assignmentId} {
        allow read: if isAdmin() || isGroupMember(groupId) || isFaculty(request.auth.uid);

        // Create: a VERIFIED faculty account creating/joining their own
        // assignment (§4 item 1, the primary teacher-initiated on-ramp) —
        // manual verification policy: an unverified faculty account can
        // complete its profile and see the dashboard, but cannot start
        // actually teaching a class until Admin approves it. Or CR/ACR/
        // CL/Admin (forward-compatible: the CR-initiated path, §4 item 2,
        // only writes routineEntries from the client today, but this
        // allowance means a future CR-facing "create the real assignment"
        // action wouldn't need another rules edit).
        allow create: if isVerifiedFaculty(request.auth.uid)
          || isGroupCR(groupId) || isGroupACR(groupId) || isCLFor(groupId) || isAdmin();

        // Update: either teacher already on the assignment (joining as
        // the 2nd slot, editing day/time, ending/soft-deleting per §8.6),
        // or the same CR/staff tier that can create one.
        allow update: if isFacultyFor(groupId, assignmentId)
          || isGroupCR(groupId) || isGroupACR(groupId) || isCLFor(groupId) || isAdmin();

        allow delete: if isAdmin(); // soft-delete via status flag is the normal path, not a real delete

        match /sessions/{sessionId} {
          allow read: if isFacultyFor(groupId, assignmentId) || isGroupCR(groupId) || isGroupACR(groupId) || isAdmin();
          allow write: if isFacultyFor(groupId, assignmentId) || isAdmin();
        }

        match /studentRecords/{studentUid} {
          // Read: the student themself, either assigned teacher, or the
          // group's CR/staff tier.
          allow read: if (isSignedIn() && request.auth.uid == studentUid)
            || isFacultyFor(groupId, assignmentId)
            || isContentEditor(groupId) || isAdmin();

          // Write: ONLY an assigned, VERIFIED (Blue Tick) teacher, and
          // only their OWN quota slot (§9.2's independent-45-per-teacher
          // rule enforced here, not just in the UI). This is the other
          // deliberate hard gate in the auto-approval policy, alongside
          // notices/{noticeId} above — marks are graded/consequential
          // data, so writing them still requires Founder-approved
          // verification even though everything else about teaching a
          // class doesn't. Split into `create` (first-ever save for a
          // student — the doc doesn't exist yet, so
          // resource.data.diff(...) isn't usable, since `resource` is null
          // on a genuine create) and `update` (every subsequent save,
          // which safely diffs against the prior doc). Missing this split
          // would break the very first marks save for any student, since
          // saveStudentMarks() in facultyMarksSync.js always calls
          // setDoc(..., {merge:true}), and Firestore treats a doc's very
          // first write as `create` even when the calling code uses
          // setDoc/merge rather than a literal .add()/create() call.
          allow create: if isFacultyFor(groupId, assignmentId) && (
            (
              get(/databases/$(database)/documents/groups/$(groupId)/facultyAssignments/$(assignmentId)).data.teacherUids[0] == request.auth.uid
              && request.resource.data.keys().hasOnly(['teacher1Marks', 'status', 'lastSentAt', 'history'])
            ) || (
              get(/databases/$(database)/documents/groups/$(groupId)/facultyAssignments/$(assignmentId)).data.teacherUids[1] == request.auth.uid
              && request.resource.data.keys().hasOnly(['teacher2Marks', 'status', 'lastSentAt', 'history'])
            )
          ) || isAdmin();

          allow update: if isFacultyFor(groupId, assignmentId) && (
            (
              get(/databases/$(database)/documents/groups/$(groupId)/facultyAssignments/$(assignmentId)).data.teacherUids[0] == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teacher1Marks', 'status', 'lastSentAt', 'history'])
            ) || (
              get(/databases/$(database)/documents/groups/$(groupId)/facultyAssignments/$(assignmentId)).data.teacherUids[1] == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teacher2Marks', 'status', 'lastSentAt', 'history'])
            )
          ) || isAdmin();

          allow delete: if isAdmin();
        }
      }

      // NOTE: no `resources` subcollection here by design — see the
      // comment in groupSync.js. Content moderation belongs in the
      // existing Question Bank system, not a parallel one.
    }

    // -------------------------------------------------------------
    // Analytics — DAU/WAU/MAU + retention + feature adoption. See
    // src/lib/activityTracking.js (writer) and src/lib/analyticsEngine.js
    // (Founder/SCL dashboard reader).
    //
    // activity/{uid} is a single heartbeat doc per user: lastActiveAt,
    // firstSeenAt, dept, batch, role. Every signed-in real (non-anonymous)
    // account may write ONLY its own doc, and may only ever narrow what
    // it writes to that fixed field set — this is a diagnostic/telemetry
    // doc, not a place a client should be able to smuggle arbitrary data
    // through. Read access is the actual access-control surface this
    // whole feature is about: Founder sees everyone, an SCL sees only
    // docs whose `dept` matches a dept they lead (enforced server-side by
    // isSCLFor(resource.data.dept), so an SCL can never read another
    // dept's activity doc even if they somehow knew the uid) — no one
    // else (Head of Ops, Content Lead, CL, faculty, students) gets read
    // access here at all, matching the explicit decision that only
    // Founder + each dept's own SCL should see usage analytics.
    match /activity/{uid} {
      allow read: if isAdmin() || (isSignedIn() && isSCLFor(resource.data.dept));
      allow create: if isRealAccount() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastActiveAt', 'firstSeenAt', 'dept', 'batch', 'role']);
      allow update: if isRealAccount() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActiveAt', 'dept', 'batch', 'role']);
      allow delete: if isAdmin();

      // moduleUsage/{moduleKey} — running useCount + lastUsedAt per
      // feature module (see moduleMap.js for the fixed set of keys).
      // Same access shape as the parent heartbeat doc: owner writes their
      // own, Founder/that dept's SCL read for the adoption breakdown.
      // Reads here resolve dept via the PARENT activity/{uid} doc (get()),
      // since moduleUsage docs themselves don't carry a dept field.
      match /moduleUsage/{moduleKey} {
        allow read: if isAdmin() || (isSignedIn()
          && isSCLFor(get(/databases/$(database)/documents/activity/$(uid)).data.dept));
        allow write: if isRealAccount() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['lastUsedAt', 'useCount']);
      }
    }
  }
}
