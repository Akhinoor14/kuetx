rules_version = '2';

// Deploy with:  firebase deploy --only firestore:rules
// Test first with the Firebase Emulator Suite.
//
// This file encodes the KUETx Manifesto v1.0 (July 2026) hierarchy:
//   Founder (admins/{uid}) -> Head of Ops + 9 Core Team leads -> Senior
//   Campus Lead (per dept) -> Campus Lead (per dept+batch) -> CR (a
//   per-class student feature, NOT an official post).
//
// Deliberate design notes carried over from earlier decisions:
// - Founder auth is a *separate* secondary Firebase app instance
//   client-side (adminAuth.js) but the SAME Firestore project/rules.
// - Removal authority is NOT symmetric with appointment authority
//   (Manifesto Code of Conduct §6): Head of Ops removes Campus Leads;
//   Founder removes Senior Campus Leads and Core Team leads. This is
//   intentional accountability separation, not an oversight.
// - Per the Data & Privacy Policy, only Founder has broad Firestore
//   access; "Data & Systems Lead / Backend Engineer" access described in
//   the manifesto is infrastructure/console-level, not additional
//   client-app Firestore rule grants — so those two roles get NO extra
//   read rules here beyond what every signed-in user already has.

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------
    // Helpers — identity & role checks
    // -------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }
    // Real account = signed in AND not an anonymous session. Firebase
    // Anonymous Auth still satisfies isSignedIn() (request.auth != null
    // is true for anonymous users too), so anything meant to be limited
    // to actual KUET students with a real Google/email account — most
    // importantly, showing up in a class's shared Classmates/CR data —
    // must check this, not just isSignedIn(). This is enforced here (not
    // only client-side in App.jsx's auto-join guard) because a client
    // guard can be bypassed by a modified/malicious client; the rule is
    // the actual security boundary. Anonymous accounts keep full access
    // to every personal-only feature (users/{uid}/data, Notes, Diary,
    // Wallet, etc.) — this restriction is scoped narrowly to group
    // membership only, same principle as the roll-ownership fallback
    // documented in App.jsx.
    function isRealAccount() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function hasGlobalRole(role) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/staff/$(request.auth.uid)/roles/$(role));
    }
    function isHeadOfOps()   { return hasGlobalRole('head_of_ops'); }
    // Currently unused by any rule below — kept for the follow-up work of
    // wiring Content Lead moderation into the existing Question Bank
    // system (see groupSync.js's note on why there's no `resources` here).
    function isContentLead() { return hasGlobalRole('content_lead'); }
    function isHeadOfGrowth(){ return hasGlobalRole('head_of_growth'); }

    function isSCLFor(dept) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/staff/$(request.auth.uid)/roles/$('senior_campus_lead_' + dept));
    }
    function isCLFor(groupId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/staff/$(request.auth.uid)/roles/$('campus_lead_' + groupId));
    }
    // A group id is always `${BATCH}_${DEPT}` (see groupUtils.js) — so the
    // department for "is this person the SCL of this group's department"
    // checks can be extracted without a second lookup.
    function deptOfGroup(groupId) {
      return groupId.split('_')[1];
    }
    function isSCLForGroup(groupId) {
      return isSCLFor(deptOfGroup(groupId));
    }

    function isGroupMember(groupId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }
    function memberDoc(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data;
    }
    // Membership check for an arbitrary OTHER uid, not the requester
    // themself — needed anywhere a CL/SCL/Admin is about to act on a
    // specific target (e.g. flagging an email) and the rule must confirm
    // that target is actually within the acting person's own scope, not
    // just that the acting person HOLDS a CL/SCL role somewhere.
    function targetIsGroupMember(uid, groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId)/members/$(uid));
    }
    function isVerifiedMember(groupId) {
      return isGroupMember(groupId) && memberDoc(groupId).verified == true;
    }
    function isGroupCR(groupId)  { return isGroupMember(groupId) && memberDoc(groupId).role == 'cr'; }
    function isGroupACR(groupId) { return isGroupMember(groupId) && memberDoc(groupId).role == 'acr'; }

    function crCount(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId)/meta/crStatus)
        ? get(/databases/$(database)/documents/groups/$(groupId)/meta/crStatus).data.count
        : 0;
    }
    // Only CR/ACR/CL/Admin can edit once a CR exists; if the group
    // currently has no CR, any *verified* member may (see conversation
    // history for why this fallback window is intentionally narrow).
    function isContentEditor(groupId) {
      return isAdmin() || isCLFor(groupId) || isGroupCR(groupId) || isGroupACR(groupId) ||
        (crCount(groupId) <= 0 && isVerifiedMember(groupId));
    }

    // Tier-1 institutional verification lives in a separate collection
    // (verifiedRolls/{roll}), written only by the dedicated verification
    // flow (kuetEmailVerify.js's secondary Firebase app session) — the
    // visitor's own main session's auth token is never touched or
    // inspected here, by design (see that file's header comment for why).
    function rollIsInstitutionallyVerified(roll) {
      return exists(/databases/$(database)/documents/verifiedRolls/$(roll));
    }

    // Roll middle 2 digits -> dept code (must mirror ROLL_DEPT_MAP in
    // ProfileSetupModal.jsx exactly — the roll digits are a numeric dept
    // *code*, not the dept name itself, so they can't be compared to
    // groupId's dept segment directly).
    function deptCodeFromRoll(roll) {
      return {
        '25': 'ARCH', '23': 'BECM', '15': 'BME', '01': 'CE', '29': 'CHE',
        '07': 'CSE', '09': 'ECE', '03': 'EEE', '13': 'ESE', '11': 'IPE',
        '19': 'LE', '05': 'ME', '27': 'MSE', '31': 'MTE', '21': 'TE', '17': 'URP',
      }[roll[2:4]];
    }

    // Tier-1 auto-verify also needs the claimed roll to actually
    // correspond to THIS group's batch+dept, not just to *any* verified
    // roll — otherwise a verified roll for one class could auto-verify
    // someone into a different class.
    //
    // Batch segment MUST be an EXACT match against the app's own
    // canonical batch format (groupUtils.js/extractBatchFromRoll:
    // "2K" + the roll's first two digits, e.g. roll 2107123 -> "2K21"),
    // not a substring check. A substring check (groupId batch containing
    // roll[0:2] ANYWHERE) would let a roll from batch 21 auto-verify
    // into a maliciously-named group like "1221_CSE" or "9921_CSE" —
    // group ids are freely creatable by any signed-in user (see
    // `groups/{groupId}` create rule below, which has no shape
    // validation), so this can't rely on groupId always being
    // well-formed; the exactness has to be enforced right here.
    function rollMatchesGroup(roll, groupId) {
      return groupId.split('_')[1] == deptCodeFromRoll(roll)
        && groupId.split('_')[0] == ('2K' + roll[0:2]);
    }

    // -------------------------------------------------------------
    // Pre-existing personal data (unchanged)
    // -------------------------------------------------------------
    match /users/{uid}/data/{key} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }
    match /users/{uid}/meta/{docId} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // -------------------------------------------------------------
    // Institutional verification facts — see kuetEmailVerify.js. Written
    // only by the separate verification-app session whose OWN auth token
    // genuinely carries a verified @stud.kuet.ac.bd email; the visitor's
    // main session is never involved in this write.
    // -------------------------------------------------------------
    match /verifiedRolls/{roll} {
      allow read: if isSignedIn();
      // MUST be an exact match of the roll to the token's verified KUET
      // email's local-part suffix — NOT a substring/contains check.
      // A substring check here (e.g. '.*' + roll + '.*@stud...') would
      // let one real mailbox like rakib2113014@stud.kuet.ac.bd satisfy
      // this rule for /verifiedRolls/113014, /verifiedRolls/211301, or
      // any other digit-substring of the real roll — none of which the
      // official kuetEmailVerify.js client ever intentionally writes,
      // but nothing stops a modified client, a stray script, or a future
      // bug from writing to those doc paths directly, since Firestore
      // rules — not client code — are the actual security boundary here.
      // Requiring the LOCAL PART TO EQUAL exactly (lowercased letters)+
      // roll, with roll itself constrained to exactly 7 digits, closes
      // that: only the one true roll encoded in the verified email can
      // ever be written, which is the guarantee rollMatchesGroup and
      // every auto-join rule downstream actually depend on.
      allow create: if request.auth.token.email_verified == true &&
        roll.matches('^[0-9]{7}$') &&
        request.auth.token.email.lower().matches('^[a-z]+' + roll + '@stud[.]kuet[.]ac[.]bd$');
      allow update, delete: if false; // create-once, permanent
    }

    // -------------------------------------------------------------
    // Roll unlock requests — fallback for when the requester has no
    // verifiedRolls proof to auto-reclaim with (see rollOwnership.js
    // requestRollUnlock()). Founder/admin resolves these directly from
    // StaffDashboard; no outside contact channel needed.
    // -------------------------------------------------------------
    match /rollUnlockRequests/{requestId} {
      allow read: if isAdmin() || isHeadOfOps()
        || (isSignedIn() && resource.data.requestedBy == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.requestedBy == request.auth.uid;
      allow update: if isAdmin() || isHeadOfOps();
      allow delete: if false;
    }

    // -------------------------------------------------------------
    // Roll ownership lock — see rollOwnership.js. One durable doc per
    // roll number so two different accounts can't both claim the same
    // student roll. First account to save with that roll owns it.
    // -------------------------------------------------------------
    match /rollOwners/{roll} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      // Normal update: owner refreshing their own claim.
      // Reclaim update: a DIFFERENT account may take over this roll's
      // ownership doc ONLY if it has already proven institutional
      // ownership of the matching KUET email (verifiedRolls/{roll}
      // exists) — see rollOwnership.js claimRoll() and
      // kuetEmailVerify.js. That proof outranks a stale/mistaken prior
      // claim by construction, since verifiedRolls itself is only ever
      // written by a session that genuinely controlled that mailbox.
      allow update: if isSignedIn() && request.resource.data.uid == request.auth.uid &&
        (resource.data.uid == request.auth.uid ||
         exists(/databases/$(database)/documents/verifiedRolls/$(roll)));
      // Owner can release their own claim (e.g. switching accounts).
      // Admin/Founder can also clear a stuck/duplicate claim manually.
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // -------------------------------------------------------------
    // Founder (single owner) — manually provisioned, never client-writable
    // -------------------------------------------------------------
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // -------------------------------------------------------------
    // Official staff hierarchy (Head of Ops, Core Team leads, SCL, CL)
    // -------------------------------------------------------------
    match /staff/{targetUid}/roles/{roleId} {
      allow read: if isAdmin() || isHeadOfOps() || request.auth.uid == targetUid;

      // Appointment authority:
      //  - Founder can assign anyone, anything.
      //  - Head of Ops can appoint Senior Campus Leads and Campus Leads.
      //  - A department's Senior Campus Lead can appoint that dept's Campus Leads.
      allow create: if isAdmin()
        || (isHeadOfOps() && request.resource.data.role in ['senior_campus_lead', 'campus_lead'])
        || (request.resource.data.role == 'campus_lead'
            && request.resource.data.scope.type == 'group'
            && isSCLForGroup(request.resource.data.scope.groupId));

      // Removal authority is intentionally asymmetric (Manifesto §6):
      //  - Founder can remove anyone.
      //  - Head of Ops can remove Campus Leads (even ones an SCL appointed —
      //    accountability check on the SCL layer).
      //  - Senior Campus Leads CANNOT remove Campus Leads themselves.
      allow delete: if isAdmin()
        || (isHeadOfOps() && resource.data.role in ['senior_campus_lead', 'campus_lead']);

      allow update: if isAdmin(); // reassigning reportsTo etc. — Founder only, keep simple
    }

    // Denormalized vacancy markers so rules/clients can check "is this
    // dept/group covered" without a collectionGroup scan.
    match /depts/{dept}/meta/sclStatus {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || isHeadOfOps();
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // Campus Lead applications — routes to that dept's SCL (or Head of
    // Ops/Founder directly if the SCL post is vacant).
    // -------------------------------------------------------------
    match /clApplications/{applicationId} {
      allow read: if isAdmin() || isHeadOfOps()
        || (isSignedIn() && isSCLFor(resource.data.dept))
        || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid
        // dept/batch/groupId must actually agree with each other — no
        // claiming leadership of one class while citing another's dept.
        && request.resource.data.groupId == (request.resource.data.batch + '_' + request.resource.data.dept)
        // and the applicant must be a real, legitimate member of that
        // exact class already (verified manually, or via a Tier-1
        // matching KUET email) — not a total stranger to it.
        && (isVerifiedMember(request.resource.data.groupId)
            || (rollIsInstitutionallyVerified(request.resource.data.roll)
                && rollMatchesGroup(request.resource.data.roll, request.resource.data.groupId)));
      allow update: if isAdmin() || isHeadOfOps() || isSCLFor(resource.data.dept);
      allow delete: if false;
    }

    // -------------------------------------------------------------
    // Email flags — manual, human-reviewed flags on EXISTING accounts
    // whose registered email looks fake/invalid (see emailFlags.js).
    // NOT an automatic ban: this only lets the right person raise a flag;
    // the account itself is untouched (no delete, no lockout) until the
    // owner responds via the in-app banner.
    //
    // Authority (same hierarchy as staff roles):
    //  - Campus Lead of the target's own group.
    //  - Senior Campus Lead of the target's dept.
    //  - Head of Ops / Founder — always, and this is also the fallback
    //    used when a dept/group's SCL/CL post is vacant, since those two
    //    roles pass the check unconditionally regardless of vacancy.
    //  - The flagged user themself can always read their own flag (so
    //    their banner can show it) but can never write/resolve it.
    // -------------------------------------------------------------
    // canFlagEmail checks the ACTOR's authority over a scope; it does
    // NOT by itself confirm the TARGET actually belongs to that scope.
    // Call sites must separately require targetIsGroupMember(targetUid,
    // groupId) — see emailFlags/{targetUid} create below — otherwise
    // any CL/SCL could flag an arbitrary uid outside their own class by
    // simply claiming their own groupId/dept in the flag payload, since
    // nothing here reads the target's actual membership.
    function canFlagEmail(dept, groupId) {
      return isAdmin() || isHeadOfOps()
        || (groupId != null && isCLFor(groupId))
        || (dept != null && isSCLFor(dept));
    }
    match /emailFlags/{targetUid} {
      allow read: if isAdmin() || isHeadOfOps() || request.auth.uid == targetUid
        || (resource.data.groupId != null && isCLFor(resource.data.groupId))
        || (resource.data.dept != null && isSCLFor(resource.data.dept));
      // create: must be shaped as a fresh, pending flag on the correct
      // doc id, by someone with authority over the scope THEY claim in
      // the doc (not a scope they'll later widen — update below can't
      // touch dept/groupId, so this is the only place scope is ever
      // set). request.resource.data.targetUid == targetUid stops
      // writing a flag under one uid's doc while pointing it at
      // another uid's data, which would let a flag "belong" to the
      // wrong owner's read grant.
      //
      // targetIsGroupMember(...) closes a separate gap: without it, a
      // CL/SCL genuinely holding authority over THEIR OWN group/dept
      // could still flag any arbitrary uid in the whole app — nothing
      // otherwise confirms the target is actually IN that group/dept.
      // Admin/Head of Ops are exempt from this extra check since their
      // authority is already global and not scope-claimed. When a
      // groupId is present the target must be a member of exactly that
      // group; the isAdmin()/isHeadOfOps() path is only skipped when
      // groupId is actually null (a dept-only flag from an SCL that has
      // no specific groupId to check against — dept-wide membership
      // isn't a single list we can cheaply verify here, so that narrow
      // case still relies on canFlagEmail's role check alone, same as
      // before).
      allow create: if isSignedIn() &&
        request.resource.data.targetUid == targetUid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.flaggedBy == request.auth.uid &&
        canFlagEmail(request.resource.data.dept, request.resource.data.groupId) &&
        (isAdmin() || isHeadOfOps()
          || request.resource.data.groupId == null
          || targetIsGroupMember(targetUid, request.resource.data.groupId));
      // update: authority is checked against the EXISTING (resource)
      // scope, same as before — but the write itself is now restricted
      // to only status/resolvedBy/resolvedAt/reason. dept and groupId
      // can never change after creation, which closes the scope-
      // escalation gap where a CL could otherwise widen a flag's
      // groupId/dept on update to one outside their own authority, or
      // where status could be bounced back to 'pending' by anyone
      // after a legitimate resolve. targetUid/flaggedBy/flaggedAt are
      // likewise immutable history, not editable fields.
      allow update: if (isAdmin() || isHeadOfOps()
          || (resource.data.groupId != null && isCLFor(resource.data.groupId))
          || (resource.data.dept != null && isSCLFor(resource.data.dept)))
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'resolvedBy', 'resolvedAt', 'reason'])
        && (request.resource.data.status == 'pending'
            || request.resource.data.status == 'resolved'
            || request.resource.data.status == 'dismissed');
      allow delete: if isAdmin() || isHeadOfOps();
    }

    // -------------------------------------------------------------
    // Global (Founder / Head of Ops) notices — flexible audience.
    // -------------------------------------------------------------
    match /notices/{noticeId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin() || isHeadOfOps();
    }

    // -------------------------------------------------------------
    // Groups — batch+dept "class" community
    // -------------------------------------------------------------
    match /groups/{groupId} {
      allow read: if isAdmin() || isGroupMember(groupId) || isCLFor(groupId) || isSCLForGroup(groupId);
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();

      match /meta/clStatus {
        allow read: if isSignedIn();
        allow create: if isAdmin() || isHeadOfOps() || isSCLForGroup(groupId);
        allow delete: if isAdmin() || isHeadOfOps(); // asymmetric, same as staff role removal above
        allow update: if isAdmin() || isHeadOfOps();
      }

      match /meta/crStatus {
        allow read: if isAdmin() || isGroupMember(groupId) || isCLFor(groupId);
        allow write: if isAdmin() || isCLFor(groupId) || isSCLForGroup(groupId) || isHeadOfOps();
      }

      match /members/{memberUid} {
        allow read: if isAdmin() || isGroupMember(groupId) || isCLFor(groupId) || isHeadOfOps() || isSCLForGroup(groupId);
        allow create: if (isRealAccount() && request.auth.uid == memberUid
                        && request.resource.data.role == 'member'
                        && (request.resource.data.verified == false
                            || (rollIsInstitutionallyVerified(request.resource.data.roll)
                                && rollMatchesGroup(request.resource.data.roll, groupId))))
                        // Fallback: approveCLApplication() bundles a CR
                        // appointment into the member doc as a set(merge:true).
                        // If the applicant's member doc somehow doesn't exist
                        // yet (e.g. their own joinGroup() write raced/failed
                        // before they clicked Claim CR), Firestore treats that
                        // merge as a CREATE, not an update — so without this,
                        // the whole approval would silently fail here even
                        // though the SCL/Admin/Head of Ops clearly has the
                        // authority to appoint CR (see the update rule below).
                        || (request.resource.data.role == 'cr' && request.resource.data.verified == true
                            && (isAdmin() || isHeadOfOps() || isSCLForGroup(groupId)));
        // Members edit only their own display fields. verified/role changes
        // are gated to CL/Admin/Head of Ops/that dept's SCL (fallback chain
        // — a request never gets stuck just because the immediate level is
        // vacant or unresponsive). The group's own CR/ACR also has a
        // narrow, field-restricted role-write power (see groupSync.js for
        // the exact app-level flows this backs):
        //   - CR can freely set role 'acr'<->'member' on anyone (assignACR/
        //     revokeACR) — no CL approval needed for that tier.
        //   - CR can set role 'member' on their OWN doc (the self-demote
        //     half of handoffCR) — always allowed, this only ever *frees*
        //     a CR slot, never creates unauthorized access.
        //   - CR can set role 'cr' on someone ELSE's doc — this is a
        //     handoff (see handoffCR in groupSync.js), where the acting
        //     CR replaces THEMSELF with a successor in the exact slot
        //     they already occupy. isGroupCR(groupId) already proves the
        //     acting user holds a CR slot, so this branch can never
        //     increase total CR count above MAX_CR by itself — it's a
        //     transfer, not a fresh appointment. (Firestore rules
        //     evaluate each doc in a batch independently, so this can't
        //     verify the acting CR ALSO demoted themself in the very same
        //     batch — but even in the worst case where they didn't, the
        //     result is one extra 'cr'-role doc that clRevokeCR/CL cleans
        //     up, not a bypass of CL approval for genuinely NEW CRs, since
        //     the target must already be an existing verified member, not
        //     an outside student being fast-tracked past a crRequests
        //     approval.)
        //   - ACR has none of this power (isGroupACR is deliberately
        //     absent from this branch).
        allow update: if isAdmin() ||
          ((isCLFor(groupId) || isHeadOfOps() || isSCLForGroup(groupId)) && request.auth.uid != memberUid) ||
          (isGroupCR(groupId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'verified']) &&
            (request.resource.data.role == 'acr' || request.resource.data.role == 'member' ||
             // A CR setting someone else to role 'cr' is a handoff — the
             // acting CR (isGroupCR already confirms this) is handing
             // over the exact slot they themself occupy. This never
             // changes total CR count (one CR replaced by another in the
             // same slot), so no extra capacity check is needed here —
             // unlike clAppointCR (CL action, genuinely fills an OPEN
             // slot), this branch is a same-slot transfer by definition
             // of who's allowed to trigger it.
             request.resource.data.role == 'cr')) ||
          (isSignedIn() && request.auth.uid == memberUid
            && request.resource.data.verified == resource.data.verified
            && request.resource.data.role == resource.data.role) ||
          // Self-service Tier-1 catch-up: if someone joined the group
          // BEFORE completing KUET email verification, their member doc
          // was created with verified:false and nothing else ever
          // revisits it. Let them flip verified false->true themselves,
          // ONLY once their exact roll is institutionally verified AND
          // matches this exact group — everything else must stay put.
          (isSignedIn() && request.auth.uid == memberUid
            && resource.data.verified == false && request.resource.data.verified == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verified'])
            && rollIsInstitutionallyVerified(resource.data.roll)
            && rollMatchesGroup(resource.data.roll, groupId));
        // Removal authority is asymmetric, same principle as the update
        // rule above: CL/Admin/Head of Ops can remove anyone. A group's
        // own CR/ACR can ALSO remove a plain member (kick from class) —
        // but never another CR/ACR outright (that must go through
        // clRevokeCR/CL escalation, not straight deletion) and never
        // themself via this path.
        allow delete: if isAdmin() || isCLFor(groupId) || isHeadOfOps() ||
          ((isGroupCR(groupId) || isGroupACR(groupId)) &&
            resource.data.role != 'cr' && resource.data.role != 'acr' &&
            request.auth.uid != memberUid);
      }

      match /crRequests/{requestUid} {
        // Two kinds of docs share this collection: a fresh CR claim (doc id
        // == the requester's own uid, no `type` field) and a CR's own
        // "let me step down" leave request (doc id == 'leave_' + their
        // uid, type:'leave', with a `uid` field holding the real uid since
        // the doc id itself is no longer the plain uid). Both need CL
        // approval, so both share the same authority model below.
        allow read: if isAdmin() || isCLFor(groupId) || isHeadOfOps() || isSCLForGroup(groupId)
          || (isSignedIn() && request.auth.uid == requestUid)
          || (isSignedIn() && resource.data.uid == request.auth.uid);
        allow create: if isSignedIn() && isVerifiedMember(groupId) &&
          ((request.auth.uid == requestUid && request.resource.data.type != 'leave')
           || (request.resource.data.type == 'leave' && request.resource.data.uid == request.auth.uid
               && requestUid == 'leave_' + request.auth.uid && isGroupCR(groupId)));
        // Resubmission: setDoc() on an existing doc is an UPDATE to
        // Firestore, not a create — so once a request has been
        // approved/rejected, the requester needs their own update path
        // to send a fresh one, or they'd be silently locked out forever
        // after a single rejection. Only allowed from a resolved
        // (non-pending) prior state, resetting straight back to pending,
        // so a requester can never flip someone else's live pending
        // request or self-approve.
        //
        // Self-cancel: a requester may also move their OWN still-pending
        // request straight to 'revoked' (never 'approved' — that stays
        // CL/Admin-only). Needed so handoffCR can clean up a CR's pending
        // leave_{uid} request when they hand off directly instead of
        // waiting for CL sign-off, and so a "cancel my request" UI is
        // possible later without a rules change.
        allow update: if isAdmin() || isCLFor(groupId) || isHeadOfOps() || isSCLForGroup(groupId) ||
          (isSignedIn() && resource.data.status != 'pending' && request.resource.data.status == 'pending' &&
            ((request.auth.uid == requestUid && request.resource.data.type != 'leave')
             || (request.resource.data.type == 'leave' && request.resource.data.uid == request.auth.uid
                 && requestUid == 'leave_' + request.auth.uid && isGroupCR(groupId)))) ||
          (isSignedIn() && resource.data.status == 'pending' && request.resource.data.status == 'revoked' &&
            ((request.auth.uid == requestUid && resource.data.type != 'leave')
             || (resource.data.type == 'leave' && resource.data.uid == request.auth.uid)));
        allow delete: if false;
      }

      match /routineEntries/{entryId} {
        allow read: if isAdmin() || isGroupMember(groupId);
        allow create, update: if isContentEditor(groupId)
          && request.resource.data.updatedBy.uid == request.auth.uid;
        allow delete: if false; // soft-delete only, via update
      }

      match /assignmentEntries/{entryId} {
        allow read: if isAdmin() || isGroupMember(groupId);
        allow create, update: if isContentEditor(groupId)
          && request.resource.data.updatedBy.uid == request.auth.uid;
        allow delete: if false; // soft-delete only, via update
      }

      match /auditLog/{logId} {
        allow read: if isAdmin() || isCLFor(groupId) || isVerifiedMember(groupId);
        allow create: if isContentEditor(groupId) && request.resource.data.by.uid == request.auth.uid;
        allow update, delete: if false; // append-only
      }

      match /notices/{noticeId} {
        allow read: if isAdmin() || isGroupMember(groupId);
        allow create: if isGroupCR(groupId) || isGroupACR(groupId) || isCLFor(groupId) || isAdmin();
        allow update, delete: if isCLFor(groupId) || isAdmin();
      }

      // NOTE: no `resources` subcollection here by design — see the
      // comment in groupSync.js. Content moderation belongs in the
      // existing Question Bank system, not a parallel one.
    }
  }
}
