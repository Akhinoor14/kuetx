rules_version = '2';

// Deploy with:  firebase deploy --only storage

service firebase.storage {
  match /b/{bucket}/o {

    // Pre-existing profile picture path (unchanged).
    match /profile-pics/{uid}/{fileName} {
      allow read: if true; // avatars are shown publicly within the app
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // NOTE: no group resource-pool path here by design — see groupSync.js's
    // note. Question Bank uploads use Cloudflare R2, not Firebase Storage,
    // so nothing else needs adding here for that.
  }
}
