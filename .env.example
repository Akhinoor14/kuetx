# Copy this file to `.env` (or `.env.local`) and fill in your Firebase
# project's actual values — Console → Project Settings → General →
# "Your apps" → SDK setup and configuration → Config.
#
# These are read by src/lib/firebase.js via import.meta.env.*

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# MULTI_CATEGORY_SERVICES_PLAN.md Phase 3 — Cloudflare R2 image upload
# for Services (cover image + up to 3 offering images). See
# service-images-worker/README_SETUP.md for how to get these two values.
VITE_SERVICE_IMAGES_WORKER_URL=
VITE_SERVICE_IMAGES_PUBLIC_BASE_URL=
