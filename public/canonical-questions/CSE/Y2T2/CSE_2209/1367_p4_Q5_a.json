    {
      "type": "text",
      "value": "Consider the grammar:"
    },
    {
      "type": "formula",
      "value": "$$\nS \\to A a A \\mid C A \\mid B a B\\tag{20) [CO3]}\n$$",
      "format": "latex"
    },
    {
      "type": "formula",
      "value": "$$\nA \\to a a B a \\mid C D A \\mid a a \\mid D C\n$$",
      "format": "latex"
    },
    {
      "type": "formula",
      "value": "$$\nC \\to C a \\mid b C \\mid D\n$$",
      "format": "latex"
    },
    {
      "type": "formula",
      "value": "$$\nD \\to b D \\mid \\epsilon\n$$",
      "format": "latex"
    },
    {
      "type": "text",
      "value": "i) eliminate e-productions,"
    },
    {
      "type": "text",
      "value": "ii) eliminate unit productions from the resulting grammar from (i),"
    },
    {
      "type": "text",
      "value": "iii) eliminate useless productions fro the resulting grammar from (ii)"
    },
    {
      "type": "text",
      "value": "iv) convert the grammar from (iii) into Chomsky Normal Form (CNF)."
    }
  ],
