    {
      "type": "text",
      "value": "Make use of the following modals in sentence as asked in the brackets: (12)"
    },
    {
      "type": "text",
      "value": "i)Shall. (To express a proposal to somebody else)"
    },
    {
      "type": "text",
      "value": "ii)Will. (To express a gentle request)"
    },
    {
      "type": "text",
      "value": "iii)Would. (To express a polite request)"
    },
    {
      "type": "text",
      "value": "iv)Dare. (To express indulgence)"
    },
    {
      "type": "text",
      "value": "v) Should + have + past participle of verb. (To express past duty which was not implemented)"
    },
    {
      "type": "text",
      "value": "vi)Can. (To express approval for someone else)"
    }
