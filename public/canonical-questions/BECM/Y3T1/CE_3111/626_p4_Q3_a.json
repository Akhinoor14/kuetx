      "value": "• Height of each floor = 3.5 m"
    },
    {
      "type": "text",
      "value": "• Plan area = 25 m x 35 m"
    },
    {
      "type": "text",
      "value": "• Seismic zone co-efficient = 0.075"
    },
    {
      "type": "text",
      "value": "• Structural importance co-efficient = 1.5"
    },
    {
      "type": "text",
      "value": "• Response modification co-efficient = 8.0"
    },
    {
      "type": "text",
      "value": "• Site co-efficient for soil characteristics = 2.0"
    },
    {
      "type": "text",
      "value": "• Seismic dead load = 2500 kN/floor"
