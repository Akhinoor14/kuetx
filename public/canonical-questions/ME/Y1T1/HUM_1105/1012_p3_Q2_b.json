    {
      "type": "text",
      "value": "Make use of the following modals in sentences as asked in brackets."
    },
    {
      "type": "text",
      "value": "i) Can. (To express offer)"
    },
    {
      "type": "text",
      "value": "ii) May. (To allow someone for something)"
    },
    {
      "type": "text",
      "value": "iii) Might. (To express uncertainty)"
    },
    {
      "type": "text",
      "value": "iv) Must. (To express logical deduction)"
    },
    {
      "type": "text",
      "value": "v) Had better. (To suggest somebody else)"
    },
    {
      "type": "text",
      "value": "vi) Be+ to+ bare form of verb. (To express command)"
    }
